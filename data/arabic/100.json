{"surah": 100, "ayahs": {"1": {"uthmani": "وَٱلْعَٰدِيَٰتِ ضَبْحًۭا", "simple": "والعاديات ضبحا", "page": 599, "juz": 30}, "2": {"uthmani": "فَٱلْمُورِيَٰتِ قَدْحًۭا", "simple": "فالموريات قدحا", "page": 599, "juz": 30}, "3": {"uthmani": "فَٱلْمُغِيرَٰتِ صُبْحًۭا", "simple": "فالمغيرات صبحا", "page": 599, "juz": 30}, "4": {"uthmani": "فَأَثَرْنَ بِهِۦ نَقْعًۭا", "simple": "فأثرن به نقعا", "page": 599, "juz": 30}, "5": {"uthmani": "فَوَسَطْنَ بِهِۦ جَمْعًا", "simple": "فوسطن به جمعا", "page": 599, "juz": 30}, "6": {"uthmani": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ", "simple": "إن الإنسان لربه لكنود", "page": 599, "juz": 30}, "7": {"uthmani": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ", "simple": "وإنه على ذلك لشهيد", "page": 599, "juz": 30}, "8": {"uthmani": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ", "simple": "وإنه لحب الخير لشديد", "page": 599, "juz": 30}, "9": {"uthmani": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ", "simple": "۞ أفلا يعلم إذا بعثر ما في القبور", "page": 599, "juz": 30}, "10": {"uthmani": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ", "simple": "وحصل ما في الصدور", "page": 600, "juz": 30}, "11": {"uthmani": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ", "simple": "إن ربهم بهم يومئذ لخبير", "page": 600, "juz": 30}}}