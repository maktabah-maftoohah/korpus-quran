{"surah": 114, "ayahs": {"1": {"uthmani": "قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ", "simple": "قل أعوذ برب الناس", "page": 604, "juz": 30}, "2": {"uthmani": "مَلِكِ ٱلنَّاسِ", "simple": "ملك الناس", "page": 604, "juz": 30}, "3": {"uthmani": "إِلَٰهِ ٱلنَّاسِ", "simple": "إله الناس", "page": 604, "juz": 30}, "4": {"uthmani": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ", "simple": "من شر الوسواس الخناس", "page": 604, "juz": 30}, "5": {"uthmani": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ", "simple": "الذي يوسوس في صدور الناس", "page": 604, "juz": 30}, "6": {"uthmani": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ", "simple": "من الجنة والناس", "page": 604, "juz": 30}}}