{"surah": 78, "ayahs": {"1": {"uthmani": "عَمَّ يَتَسَآءَلُونَ", "simple": "عم يتساءلون", "page": 582, "juz": 30}, "2": {"uthmani": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ", "simple": "عن النبإ العظيم", "page": 582, "juz": 30}, "3": {"uthmani": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ", "simple": "الذي هم فيه مختلفون", "page": 582, "juz": 30}, "4": {"uthmani": "كَلَّا سَيَعْلَمُونَ", "simple": "كلا سيعلمون", "page": 582, "juz": 30}, "5": {"uthmani": "ثُمَّ كَلَّا سَيَعْلَمُونَ", "simple": "ثم كلا سيعلمون", "page": 582, "juz": 30}, "6": {"uthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا", "simple": "ألم نجعل الأرض مهادا", "page": 582, "juz": 30}, "7": {"uthmani": "وَٱلْجِبَالَ أَوْتَادًۭا", "simple": "والجبال أوتادا", "page": 582, "juz": 30}, "8": {"uthmani": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا", "simple": "وخلقناكم أزواجا", "page": 582, "juz": 30}, "9": {"uthmani": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا", "simple": "وجعلنا نومكم سباتا", "page": 582, "juz": 30}, "10": {"uthmani": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا", "simple": "وجعلنا الليل لباسا", "page": 582, "juz": 30}, "11": {"uthmani": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا", "simple": "وجعلنا النهار معاشا", "page": 582, "juz": 30}, "12": {"uthmani": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا", "simple": "وبنينا فوقكم سبعا شدادا", "page": 582, "juz": 30}, "13": {"uthmani": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا", "simple": "وجعلنا سراجا وهاجا", "page": 582, "juz": 30}, "14": {"uthmani": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا", "simple": "وأنزلنا من المعصرات ماء ثجاجا", "page": 582, "juz": 30}, "15": {"uthmani": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا", "simple": "لنخرج به حبا ونباتا", "page": 582, "juz": 30}, "16": {"uthmani": "وَجَنَّٰتٍ أَلْفَافًا", "simple": "وجنات ألفافا", "page": 582, "juz": 30}, "17": {"uthmani": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا", "simple": "إن يوم الفصل كان ميقاتا", "page": 582, "juz": 30}, "18": {"uthmani": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا", "simple": "يوم ينفخ في الصور فتأتون أفواجا", "page": 582, "juz": 30}, "19": {"uthmani": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا", "simple": "وفتحت السماء فكانت أبوابا", "page": 582, "juz": 30}, "20": {"uthmani": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا", "simple": "وسيرت الجبال فكانت سرابا", "page": 582, "juz": 30}, "21": {"uthmani": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا", "simple": "إن جهنم كانت مرصادا", "page": 582, "juz": 30}, "22": {"uthmani": "لِّلطَّٰغِينَ مَـَٔابًۭا", "simple": "للطاغين مآبا", "page": 582, "juz": 30}, "23": {"uthmani": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا", "simple": "لابثين فيها أحقابا", "page": 582, "juz": 30}, "24": {"uthmani": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا", "simple": "لا يذوقون فيها بردا ولا شرابا", "page": 582, "juz": 30}, "25": {"uthmani": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا", "simple": "إلا حميما وغساقا", "page": 582, "juz": 30}, "26": {"uthmani": "جَزَآءًۭ وِفَاقًا", "simple": "جزاء وفاقا", "page": 582, "juz": 30}, "27": {"uthmani": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا", "simple": "إنهم كانوا لا يرجون حسابا", "page": 582, "juz": 30}, "28": {"uthmani": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا", "simple": "وكذبوا بآياتنا كذابا", "page": 582, "juz": 30}, "29": {"uthmani": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا", "simple": "وكل شيء أحصيناه كتابا", "page": 582, "juz": 30}, "30": {"uthmani": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا", "simple": "فذوقوا فلن نزيدكم إلا عذابا", "page": 582, "juz": 30}, "31": {"uthmani": "إِنَّ لِلْمُتَّقِينَ مَفَازًا", "simple": "إن للمتقين مفازا", "page": 583, "juz": 30}, "32": {"uthmani": "حَدَآئِقَ وَأَعْنَٰبًۭا", "simple": "حدائق وأعنابا", "page": 583, "juz": 30}, "33": {"uthmani": "وَكَوَاعِبَ أَتْرَابًۭا", "simple": "وكواعب أترابا", "page": 583, "juz": 30}, "34": {"uthmani": "وَكَأْسًۭا دِهَاقًۭا", "simple": "وكأسا دهاقا", "page": 583, "juz": 30}, "35": {"uthmani": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا", "simple": "لا يسمعون فيها لغوا ولا كذابا", "page": 583, "juz": 30}, "36": {"uthmani": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا", "simple": "جزاء من ربك عطاء حسابا", "page": 583, "juz": 30}, "37": {"uthmani": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا", "simple": "رب السماوات والأرض وما بينهما الرحمن ۖ لا يملكون منه خطابا", "page": 583, "juz": 30}, "38": {"uthmani": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا", "simple": "يوم يقوم الروح والملائكة صفا ۖ لا يتكلمون إلا من أذن له الرحمن وقال صوابا", "page": 583, "juz": 30}, "39": {"uthmani": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا", "simple": "ذلك اليوم الحق ۖ فمن شاء اتخذ إلى ربه مآبا", "page": 583, "juz": 30}, "40": {"uthmani": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا", "simple": "إنا أنذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر يا ليتني كنت ترابا", "page": 583, "juz": 30}}}