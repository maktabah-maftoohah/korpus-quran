{"surah": 104, "ayahs": {"1": {"uthmani": "وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ", "simple": "ويل لكل همزة لمزة", "page": 601, "juz": 30}, "2": {"uthmani": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ", "simple": "الذي جمع مالا وعدده", "page": 601, "juz": 30}, "3": {"uthmani": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ", "simple": "يحسب أن ماله أخلده", "page": 601, "juz": 30}, "4": {"uthmani": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ", "simple": "كلا ۖ لينبذن في الحطمة", "page": 601, "juz": 30}, "5": {"uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ", "simple": "وما أدراك ما الحطمة", "page": 601, "juz": 30}, "6": {"uthmani": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ", "simple": "نار الله الموقدة", "page": 601, "juz": 30}, "7": {"uthmani": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ", "simple": "التي تطلع على الأفئدة", "page": 601, "juz": 30}, "8": {"uthmani": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ", "simple": "إنها عليهم مؤصدة", "page": 601, "juz": 30}, "9": {"uthmani": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ", "simple": "في عمد ممددة", "page": 601, "juz": 30}}}