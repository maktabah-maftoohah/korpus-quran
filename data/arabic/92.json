{"surah": 92, "ayahs": {"1": {"uthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰ", "simple": "والليل إذا يغشى", "page": 595, "juz": 30}, "2": {"uthmani": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ", "simple": "والنهار إذا تجلى", "page": 595, "juz": 30}, "3": {"uthmani": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "simple": "وما خلق الذكر والأنثى", "page": 595, "juz": 30}, "4": {"uthmani": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ", "simple": "إن سعيكم لشتى", "page": 595, "juz": 30}, "5": {"uthmani": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ", "simple": "فأما من أعطى واتقى", "page": 595, "juz": 30}, "6": {"uthmani": "وَصَدَّقَ بِٱلْحُسْنَىٰ", "simple": "وصدق بالحسنى", "page": 595, "juz": 30}, "7": {"uthmani": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ", "simple": "فسنيسره لليسرى", "page": 595, "juz": 30}, "8": {"uthmani": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ", "simple": "وأما من بخل واستغنى", "page": 595, "juz": 30}, "9": {"uthmani": "وَكَذَّبَ بِٱلْحُسْنَىٰ", "simple": "وكذب بالحسنى", "page": 595, "juz": 30}, "10": {"uthmani": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ", "simple": "فسنيسره للعسرى", "page": 595, "juz": 30}, "11": {"uthmani": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ", "simple": "وما يغني عنه ماله إذا تردى", "page": 595, "juz": 30}, "12": {"uthmani": "إِنَّ عَلَيْنَا لَلْهُدَىٰ", "simple": "إن علينا للهدى", "page": 595, "juz": 30}, "13": {"uthmani": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ", "simple": "وإن لنا للآخرة والأولى", "page": 595, "juz": 30}, "14": {"uthmani": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ", "simple": "فأنذرتكم نارا تلظى", "page": 595, "juz": 30}, "15": {"uthmani": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى", "simple": "لا يصلاها إلا الأشقى", "page": 596, "juz": 30}, "16": {"uthmani": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ", "simple": "الذي كذب وتولى", "page": 596, "juz": 30}, "17": {"uthmani": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى", "simple": "وسيجنبها الأتقى", "page": 596, "juz": 30}, "18": {"uthmani": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ", "simple": "الذي يؤتي ماله يتزكى", "page": 596, "juz": 30}, "19": {"uthmani": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ", "simple": "وما لأحد عنده من نعمة تجزى", "page": 596, "juz": 30}, "20": {"uthmani": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ", "simple": "إلا ابتغاء وجه ربه الأعلى", "page": 596, "juz": 30}, "21": {"uthmani": "وَلَسَوْفَ يَرْضَىٰ", "simple": "ولسوف يرضى", "page": 596, "juz": 30}}}