{"surah": 93, "ayahs": {"1": {"uthmani": "وَٱلضُّحَىٰ", "simple": "والضحى", "page": 596, "juz": 30}, "2": {"uthmani": "وَٱلَّيْلِ إِذَا سَجَىٰ", "simple": "والليل إذا سجى", "page": 596, "juz": 30}, "3": {"uthmani": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ", "simple": "ما ودعك ربك وما قلى", "page": 596, "juz": 30}, "4": {"uthmani": "وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ", "simple": "وللآخرة خير لك من الأولى", "page": 596, "juz": 30}, "5": {"uthmani": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ", "simple": "ولسوف يعطيك ربك فترضى", "page": 596, "juz": 30}, "6": {"uthmani": "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ", "simple": "ألم يجدك يتيما فآوى", "page": 596, "juz": 30}, "7": {"uthmani": "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ", "simple": "ووجدك ضالا فهدى", "page": 596, "juz": 30}, "8": {"uthmani": "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ", "simple": "ووجدك عائلا فأغنى", "page": 596, "juz": 30}, "9": {"uthmani": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ", "simple": "فأما اليتيم فلا تقهر", "page": 596, "juz": 30}, "10": {"uthmani": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ", "simple": "وأما السائل فلا تنهر", "page": 596, "juz": 30}, "11": {"uthmani": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ", "simple": "وأما بنعمة ربك فحدث", "page": 596, "juz": 30}}}