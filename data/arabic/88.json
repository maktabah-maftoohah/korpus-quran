{"surah": 88, "ayahs": {"1": {"uthmani": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "simple": "هل أتاك حديث الغاشية", "page": 592, "juz": 30}, "2": {"uthmani": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "simple": "وجوه يومئذ خاشعة", "page": 592, "juz": 30}, "3": {"uthmani": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "simple": "عاملة ناصبة", "page": 592, "juz": 30}, "4": {"uthmani": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "simple": "تصلى نارا حامية", "page": 592, "juz": 30}, "5": {"uthmani": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "simple": "تسقى من عين آنية", "page": 592, "juz": 30}, "6": {"uthmani": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "simple": "ليس لهم طعام إلا من ضريع", "page": 592, "juz": 30}, "7": {"uthmani": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "simple": "لا يسمن ولا يغني من جوع", "page": 592, "juz": 30}, "8": {"uthmani": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ", "simple": "وجوه يومئذ ناعمة", "page": 592, "juz": 30}, "9": {"uthmani": "لِّسَعْيِهَا رَاضِيَةٌۭ", "simple": "لسعيها راضية", "page": 592, "juz": 30}, "10": {"uthmani": "فِى جَنَّةٍ عَالِيَةٍۢ", "simple": "في جنة عالية", "page": 592, "juz": 30}, "11": {"uthmani": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ", "simple": "لا تسمع فيها لاغية", "page": 592, "juz": 30}, "12": {"uthmani": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ", "simple": "فيها عين جارية", "page": 592, "juz": 30}, "13": {"uthmani": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ", "simple": "فيها سرر مرفوعة", "page": 592, "juz": 30}, "14": {"uthmani": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ", "simple": "وأكواب موضوعة", "page": 592, "juz": 30}, "15": {"uthmani": "وَنَمَارِقُ مَصْفُوفَةٌۭ", "simple": "ونمارق مصفوفة", "page": 592, "juz": 30}, "16": {"uthmani": "وَزَرَابِىُّ مَبْثُوثَةٌ", "simple": "وزرابي مبثوثة", "page": 592, "juz": 30}, "17": {"uthmani": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ", "simple": "أفلا ينظرون إلى الإبل كيف خلقت", "page": 592, "juz": 30}, "18": {"uthmani": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ", "simple": "وإلى السماء كيف رفعت", "page": 592, "juz": 30}, "19": {"uthmani": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ", "simple": "وإلى الجبال كيف نصبت", "page": 592, "juz": 30}, "20": {"uthmani": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ", "simple": "وإلى الأرض كيف سطحت", "page": 592, "juz": 30}, "21": {"uthmani": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ", "simple": "فذكر إنما أنت مذكر", "page": 592, "juz": 30}, "22": {"uthmani": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ", "simple": "لست عليهم بمصيطر", "page": 592, "juz": 30}, "23": {"uthmani": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ", "simple": "إلا من تولى وكفر", "page": 592, "juz": 30}, "24": {"uthmani": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ", "simple": "فيعذبه الله العذاب الأكبر", "page": 592, "juz": 30}, "25": {"uthmani": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "simple": "إن إلينا إيابهم", "page": 592, "juz": 30}, "26": {"uthmani": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم", "simple": "ثم إن علينا حسابهم", "page": 592, "juz": 30}}}