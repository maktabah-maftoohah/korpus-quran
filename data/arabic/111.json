{"surah": 111, "ayahs": {"1": {"uthmani": "تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ", "simple": "تبت يدا أبي لهب وتب", "page": 603, "juz": 30}, "2": {"uthmani": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ", "simple": "ما أغنى عنه ماله وما كسب", "page": 603, "juz": 30}, "3": {"uthmani": "سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ", "simple": "سيصلى نارا ذات لهب", "page": 603, "juz": 30}, "4": {"uthmani": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ", "simple": "وامرأته حمالة الحطب", "page": 603, "juz": 30}, "5": {"uthmani": "فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ", "simple": "في جيدها حبل من مسد", "page": 603, "juz": 30}}}