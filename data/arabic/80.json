{"surah": 80, "ayahs": {"1": {"uthmani": "عَبَسَ وَتَوَلَّىٰٓ", "simple": "عبس وتولى", "page": 585, "juz": 30}, "2": {"uthmani": "أَن جَآءَهُ ٱلْأَعْمَىٰ", "simple": "أن جاءه الأعمى", "page": 585, "juz": 30}, "3": {"uthmani": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ", "simple": "وما يدريك لعله يزكى", "page": 585, "juz": 30}, "4": {"uthmani": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ", "simple": "أو يذكر فتنفعه الذكرى", "page": 585, "juz": 30}, "5": {"uthmani": "أَمَّا مَنِ ٱسْتَغْنَىٰ", "simple": "أما من استغنى", "page": 585, "juz": 30}, "6": {"uthmani": "فَأَنتَ لَهُۥ تَصَدَّىٰ", "simple": "فأنت له تصدى", "page": 585, "juz": 30}, "7": {"uthmani": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ", "simple": "وما عليك ألا يزكى", "page": 585, "juz": 30}, "8": {"uthmani": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ", "simple": "وأما من جاءك يسعى", "page": 585, "juz": 30}, "9": {"uthmani": "وَهُوَ يَخْشَىٰ", "simple": "وهو يخشى", "page": 585, "juz": 30}, "10": {"uthmani": "فَأَنتَ عَنْهُ تَلَهَّىٰ", "simple": "فأنت عنه تلهى", "page": 585, "juz": 30}, "11": {"uthmani": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ", "simple": "كلا إنها تذكرة", "page": 585, "juz": 30}, "12": {"uthmani": "فَمَن شَآءَ ذَكَرَهُۥ", "simple": "فمن شاء ذكره", "page": 585, "juz": 30}, "13": {"uthmani": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ", "simple": "في صحف مكرمة", "page": 585, "juz": 30}, "14": {"uthmani": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ", "simple": "مرفوعة مطهرة", "page": 585, "juz": 30}, "15": {"uthmani": "بِأَيْدِى سَفَرَةٍۢ", "simple": "بأيدي سفرة", "page": 585, "juz": 30}, "16": {"uthmani": "كِرَامٍۭ بَرَرَةٍۢ", "simple": "كرام بررة", "page": 585, "juz": 30}, "17": {"uthmani": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ", "simple": "قتل الإنسان ما أكفره", "page": 585, "juz": 30}, "18": {"uthmani": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ", "simple": "من أي شيء خلقه", "page": 585, "juz": 30}, "19": {"uthmani": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ", "simple": "من نطفة خلقه فقدره", "page": 585, "juz": 30}, "20": {"uthmani": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ", "simple": "ثم السبيل يسره", "page": 585, "juz": 30}, "21": {"uthmani": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ", "simple": "ثم أماته فأقبره", "page": 585, "juz": 30}, "22": {"uthmani": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ", "simple": "ثم إذا شاء أنشره", "page": 585, "juz": 30}, "23": {"uthmani": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ", "simple": "كلا لما يقض ما أمره", "page": 585, "juz": 30}, "24": {"uthmani": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ", "simple": "فلينظر الإنسان إلى طعامه", "page": 585, "juz": 30}, "25": {"uthmani": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا", "simple": "أنا صببنا الماء صبا", "page": 585, "juz": 30}, "26": {"uthmani": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا", "simple": "ثم شققنا الأرض شقا", "page": 585, "juz": 30}, "27": {"uthmani": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا", "simple": "فأنبتنا فيها حبا", "page": 585, "juz": 30}, "28": {"uthmani": "وَعِنَبًۭا وَقَضْبًۭا", "simple": "وعنبا وقضبا", "page": 585, "juz": 30}, "29": {"uthmani": "وَزَيْتُونًۭا وَنَخْلًۭا", "simple": "وزيتونا ونخلا", "page": 585, "juz": 30}, "30": {"uthmani": "وَحَدَآئِقَ غُلْبًۭا", "simple": "وحدائق غلبا", "page": 585, "juz": 30}, "31": {"uthmani": "وَفَٰكِهَةًۭ وَأَبًّۭا", "simple": "وفاكهة وأبا", "page": 585, "juz": 30}, "32": {"uthmani": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "simple": "متاعا لكم ولأنعامكم", "page": 585, "juz": 30}, "33": {"uthmani": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ", "simple": "فإذا جاءت الصاخة", "page": 585, "juz": 30}, "34": {"uthmani": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ", "simple": "يوم يفر المرء من أخيه", "page": 585, "juz": 30}, "35": {"uthmani": "وَأُمِّهِۦ وَأَبِيهِ", "simple": "وأمه وأبيه", "page": 585, "juz": 30}, "36": {"uthmani": "وَصَٰحِبَتِهِۦ وَبَنِيهِ", "simple": "وصاحبته وبنيه", "page": 585, "juz": 30}, "37": {"uthmani": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ", "simple": "لكل امرئ منهم يومئذ شأن يغنيه", "page": 585, "juz": 30}, "38": {"uthmani": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ", "simple": "وجوه يومئذ مسفرة", "page": 585, "juz": 30}, "39": {"uthmani": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ", "simple": "ضاحكة مستبشرة", "page": 585, "juz": 30}, "40": {"uthmani": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ", "simple": "ووجوه يومئذ عليها غبرة", "page": 585, "juz": 30}, "41": {"uthmani": "تَرْهَقُهَا قَتَرَةٌ", "simple": "ترهقها قترة", "page": 585, "juz": 30}, "42": {"uthmani": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ", "simple": "أولئك هم الكفرة الفجرة", "page": 585, "juz": 30}}}