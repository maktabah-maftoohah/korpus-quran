{"surah": 55, "ayahs": {"1": {"uthmani": "ٱلرَّحْمَٰنُ", "simple": "الرحمن", "page": 531, "juz": 27}, "2": {"uthmani": "عَلَّمَ ٱلْقُرْءَانَ", "simple": "علم القرآن", "page": 531, "juz": 27}, "3": {"uthmani": "خَلَقَ ٱلْإِنسَٰنَ", "simple": "خلق الإنسان", "page": 531, "juz": 27}, "4": {"uthmani": "عَلَّمَهُ ٱلْبَيَانَ", "simple": "علمه البيان", "page": 531, "juz": 27}, "5": {"uthmani": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ", "simple": "الشمس والقمر بحسبان", "page": 531, "juz": 27}, "6": {"uthmani": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ", "simple": "والنجم والشجر يسجدان", "page": 531, "juz": 27}, "7": {"uthmani": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ", "simple": "والسماء رفعها ووضع الميزان", "page": 531, "juz": 27}, "8": {"uthmani": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ", "simple": "ألا تطغوا في الميزان", "page": 531, "juz": 27}, "9": {"uthmani": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ", "simple": "وأقيموا الوزن بالقسط ولا تخسروا الميزان", "page": 531, "juz": 27}, "10": {"uthmani": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ", "simple": "والأرض وضعها للأنام", "page": 531, "juz": 27}, "11": {"uthmani": "فِيهَا فَٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ", "simple": "فيها فاكهة والنخل ذات الأكمام", "page": 531, "juz": 27}, "12": {"uthmani": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ", "simple": "والحب ذو العصف والريحان", "page": 531, "juz": 27}, "13": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 531, "juz": 27}, "14": {"uthmani": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍۢ كَٱلْفَخَّارِ", "simple": "خلق الإنسان من صلصال كالفخار", "page": 531, "juz": 27}, "15": {"uthmani": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ", "simple": "وخلق الجان من مارج من نار", "page": 531, "juz": 27}, "16": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 531, "juz": 27}, "17": {"uthmani": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ", "simple": "رب المشرقين ورب المغربين", "page": 532, "juz": 27}, "18": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "19": {"uthmani": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ", "simple": "مرج البحرين يلتقيان", "page": 532, "juz": 27}, "20": {"uthmani": "بَيْنَهُمَا بَرْزَخٌۭ لَّا يَبْغِيَانِ", "simple": "بينهما برزخ لا يبغيان", "page": 532, "juz": 27}, "21": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "22": {"uthmani": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ", "simple": "يخرج منهما اللؤلؤ والمرجان", "page": 532, "juz": 27}, "23": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "24": {"uthmani": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ", "simple": "وله الجوار المنشآت في البحر كالأعلام", "page": 532, "juz": 27}, "25": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "26": {"uthmani": "كُلُّ مَنْ عَلَيْهَا فَانٍۢ", "simple": "كل من عليها فان", "page": 532, "juz": 27}, "27": {"uthmani": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ", "simple": "ويبقى وجه ربك ذو الجلال والإكرام", "page": 532, "juz": 27}, "28": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "29": {"uthmani": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ", "simple": "يسأله من في السماوات والأرض ۚ كل يوم هو في شأن", "page": 532, "juz": 27}, "30": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "31": {"uthmani": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ", "simple": "سنفرغ لكم أيه الثقلان", "page": 532, "juz": 27}, "32": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "33": {"uthmani": "يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍۢ", "simple": "يا معشر الجن والإنس إن استطعتم أن تنفذوا من أقطار السماوات والأرض فانفذوا ۚ لا تنفذون إلا بسلطان", "page": 532, "juz": 27}, "34": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "35": {"uthmani": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌۭ مِّن نَّارٍۢ وَنُحَاسٌۭ فَلَا تَنتَصِرَانِ", "simple": "يرسل عليكما شواظ من نار ونحاس فلا تنتصران", "page": 532, "juz": 27}, "36": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "37": {"uthmani": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةًۭ كَٱلدِّهَانِ", "simple": "فإذا انشقت السماء فكانت وردة كالدهان", "page": 532, "juz": 27}, "38": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "39": {"uthmani": "فَيَوْمَئِذٍۢ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌۭ وَلَا جَآنٌّۭ", "simple": "فيومئذ لا يسأل عن ذنبه إنس ولا جان", "page": 532, "juz": 27}, "40": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 532, "juz": 27}, "41": {"uthmani": "يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ", "simple": "يعرف المجرمون بسيماهم فيؤخذ بالنواصي والأقدام", "page": 533, "juz": 27}, "42": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "43": {"uthmani": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ", "simple": "هذه جهنم التي يكذب بها المجرمون", "page": 533, "juz": 27}, "44": {"uthmani": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍۢ", "simple": "يطوفون بينها وبين حميم آن", "page": 533, "juz": 27}, "45": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "46": {"uthmani": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ", "simple": "ولمن خاف مقام ربه جنتان", "page": 533, "juz": 27}, "47": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "48": {"uthmani": "ذَوَاتَآ أَفْنَانٍۢ", "simple": "ذواتا أفنان", "page": 533, "juz": 27}, "49": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "50": {"uthmani": "فِيهِمَا عَيْنَانِ تَجْرِيَانِ", "simple": "فيهما عينان تجريان", "page": 533, "juz": 27}, "51": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "52": {"uthmani": "فِيهِمَا مِن كُلِّ فَٰكِهَةٍۢ زَوْجَانِ", "simple": "فيهما من كل فاكهة زوجان", "page": 533, "juz": 27}, "53": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "54": {"uthmani": "مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍۢ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍۢ", "simple": "متكئين على فرش بطائنها من إستبرق ۚ وجنى الجنتين دان", "page": 533, "juz": 27}, "55": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "56": {"uthmani": "فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ", "simple": "فيهن قاصرات الطرف لم يطمثهن إنس قبلهم ولا جان", "page": 533, "juz": 27}, "57": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "58": {"uthmani": "كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ", "simple": "كأنهن الياقوت والمرجان", "page": 533, "juz": 27}, "59": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "60": {"uthmani": "هَلْ جَزَآءُ ٱلْإِحْسَٰنِ إِلَّا ٱلْإِحْسَٰنُ", "simple": "هل جزاء الإحسان إلا الإحسان", "page": 533, "juz": 27}, "61": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "62": {"uthmani": "وَمِن دُونِهِمَا جَنَّتَانِ", "simple": "ومن دونهما جنتان", "page": 533, "juz": 27}, "63": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "64": {"uthmani": "مُدْهَآمَّتَانِ", "simple": "مدهامتان", "page": 533, "juz": 27}, "65": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "66": {"uthmani": "فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ", "simple": "فيهما عينان نضاختان", "page": 533, "juz": 27}, "67": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 533, "juz": 27}, "68": {"uthmani": "فِيهِمَا فَٰكِهَةٌۭ وَنَخْلٌۭ وَرُمَّانٌۭ", "simple": "فيهما فاكهة ونخل ورمان", "page": 534, "juz": 27}, "69": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 534, "juz": 27}, "70": {"uthmani": "فِيهِنَّ خَيْرَٰتٌ حِسَانٌۭ", "simple": "فيهن خيرات حسان", "page": 534, "juz": 27}, "71": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 534, "juz": 27}, "72": {"uthmani": "حُورٌۭ مَّقْصُورَٰتٌۭ فِى ٱلْخِيَامِ", "simple": "حور مقصورات في الخيام", "page": 534, "juz": 27}, "73": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 534, "juz": 27}, "74": {"uthmani": "لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ", "simple": "لم يطمثهن إنس قبلهم ولا جان", "page": 534, "juz": 27}, "75": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 534, "juz": 27}, "76": {"uthmani": "مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍۢ وَعَبْقَرِىٍّ حِسَانٍۢ", "simple": "متكئين على رفرف خضر وعبقري حسان", "page": 534, "juz": 27}, "77": {"uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "simple": "فبأي آلاء ربكما تكذبان", "page": 534, "juz": 27}, "78": {"uthmani": "تَبَٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَٰلِ وَٱلْإِكْرَامِ", "simple": "تبارك اسم ربك ذي الجلال والإكرام", "page": 534, "juz": 27}}}