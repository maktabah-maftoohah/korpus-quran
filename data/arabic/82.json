{"surah": 82, "ayahs": {"1": {"uthmani": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ", "simple": "إذا السماء انفطرت", "page": 587, "juz": 30}, "2": {"uthmani": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ", "simple": "وإذا الكواكب انتثرت", "page": 587, "juz": 30}, "3": {"uthmani": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ", "simple": "وإذا البحار فجرت", "page": 587, "juz": 30}, "4": {"uthmani": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ", "simple": "وإذا القبور بعثرت", "page": 587, "juz": 30}, "5": {"uthmani": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ", "simple": "علمت نفس ما قدمت وأخرت", "page": 587, "juz": 30}, "6": {"uthmani": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ", "simple": "يا أيها الإنسان ما غرك بربك الكريم", "page": 587, "juz": 30}, "7": {"uthmani": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ", "simple": "الذي خلقك فسواك فعدلك", "page": 587, "juz": 30}, "8": {"uthmani": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ", "simple": "في أي صورة ما شاء ركبك", "page": 587, "juz": 30}, "9": {"uthmani": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ", "simple": "كلا بل تكذبون بالدين", "page": 587, "juz": 30}, "10": {"uthmani": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ", "simple": "وإن عليكم لحافظين", "page": 587, "juz": 30}, "11": {"uthmani": "كِرَامًۭا كَٰتِبِينَ", "simple": "كراما كاتبين", "page": 587, "juz": 30}, "12": {"uthmani": "يَعْلَمُونَ مَا تَفْعَلُونَ", "simple": "يعلمون ما تفعلون", "page": 587, "juz": 30}, "13": {"uthmani": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ", "simple": "إن الأبرار لفي نعيم", "page": 587, "juz": 30}, "14": {"uthmani": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ", "simple": "وإن الفجار لفي جحيم", "page": 587, "juz": 30}, "15": {"uthmani": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ", "simple": "يصلونها يوم الدين", "page": 587, "juz": 30}, "16": {"uthmani": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ", "simple": "وما هم عنها بغائبين", "page": 587, "juz": 30}, "17": {"uthmani": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "simple": "وما أدراك ما يوم الدين", "page": 587, "juz": 30}, "18": {"uthmani": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "simple": "ثم ما أدراك ما يوم الدين", "page": 587, "juz": 30}, "19": {"uthmani": "يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ", "simple": "يوم لا تملك نفس لنفس شيئا ۖ والأمر يومئذ لله", "page": 587, "juz": 30}}}