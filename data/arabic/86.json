{"surah": 86, "ayahs": {"1": {"uthmani": "وَٱلسَّمَآءِ وَٱلطَّارِقِ", "simple": "والسماء والطارق", "page": 591, "juz": 30}, "2": {"uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ", "simple": "وما أدراك ما الطارق", "page": 591, "juz": 30}, "3": {"uthmani": "ٱلنَّجْمُ ٱلثَّاقِبُ", "simple": "النجم الثاقب", "page": 591, "juz": 30}, "4": {"uthmani": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ", "simple": "إن كل نفس لما عليها حافظ", "page": 591, "juz": 30}, "5": {"uthmani": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ", "simple": "فلينظر الإنسان مم خلق", "page": 591, "juz": 30}, "6": {"uthmani": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ", "simple": "خلق من ماء دافق", "page": 591, "juz": 30}, "7": {"uthmani": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ", "simple": "يخرج من بين الصلب والترائب", "page": 591, "juz": 30}, "8": {"uthmani": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ", "simple": "إنه على رجعه لقادر", "page": 591, "juz": 30}, "9": {"uthmani": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ", "simple": "يوم تبلى السرائر", "page": 591, "juz": 30}, "10": {"uthmani": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ", "simple": "فما له من قوة ولا ناصر", "page": 591, "juz": 30}, "11": {"uthmani": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ", "simple": "والسماء ذات الرجع", "page": 591, "juz": 30}, "12": {"uthmani": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ", "simple": "والأرض ذات الصدع", "page": 591, "juz": 30}, "13": {"uthmani": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ", "simple": "إنه لقول فصل", "page": 591, "juz": 30}, "14": {"uthmani": "وَمَا هُوَ بِٱلْهَزْلِ", "simple": "وما هو بالهزل", "page": 591, "juz": 30}, "15": {"uthmani": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا", "simple": "إنهم يكيدون كيدا", "page": 591, "juz": 30}, "16": {"uthmani": "وَأَكِيدُ كَيْدًۭا", "simple": "وأكيد كيدا", "page": 591, "juz": 30}, "17": {"uthmani": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا", "simple": "فمهل الكافرين أمهلهم رويدا", "page": 591, "juz": 30}}}