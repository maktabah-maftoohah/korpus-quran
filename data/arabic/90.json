{"surah": 90, "ayahs": {"1": {"uthmani": "لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ", "simple": "لا أقسم بهذا البلد", "page": 594, "juz": 30}, "2": {"uthmani": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ", "simple": "وأنت حل بهذا البلد", "page": 594, "juz": 30}, "3": {"uthmani": "وَوَالِدٍۢ وَمَا وَلَدَ", "simple": "ووالد وما ولد", "page": 594, "juz": 30}, "4": {"uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ", "simple": "لقد خلقنا الإنسان في كبد", "page": 594, "juz": 30}, "5": {"uthmani": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ", "simple": "أيحسب أن لن يقدر عليه أحد", "page": 594, "juz": 30}, "6": {"uthmani": "يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا", "simple": "يقول أهلكت مالا لبدا", "page": 594, "juz": 30}, "7": {"uthmani": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ", "simple": "أيحسب أن لم يره أحد", "page": 594, "juz": 30}, "8": {"uthmani": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ", "simple": "ألم نجعل له عينين", "page": 594, "juz": 30}, "9": {"uthmani": "وَلِسَانًۭا وَشَفَتَيْنِ", "simple": "ولسانا وشفتين", "page": 594, "juz": 30}, "10": {"uthmani": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ", "simple": "وهديناه النجدين", "page": 594, "juz": 30}, "11": {"uthmani": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ", "simple": "فلا اقتحم العقبة", "page": 594, "juz": 30}, "12": {"uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ", "simple": "وما أدراك ما العقبة", "page": 594, "juz": 30}, "13": {"uthmani": "فَكُّ رَقَبَةٍ", "simple": "فك رقبة", "page": 594, "juz": 30}, "14": {"uthmani": "أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ", "simple": "أو إطعام في يوم ذي مسغبة", "page": 594, "juz": 30}, "15": {"uthmani": "يَتِيمًۭا ذَا مَقْرَبَةٍ", "simple": "يتيما ذا مقربة", "page": 594, "juz": 30}, "16": {"uthmani": "أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ", "simple": "أو مسكينا ذا متربة", "page": 594, "juz": 30}, "17": {"uthmani": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ", "simple": "ثم كان من الذين آمنوا وتواصوا بالصبر وتواصوا بالمرحمة", "page": 594, "juz": 30}, "18": {"uthmani": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ", "simple": "أولئك أصحاب الميمنة", "page": 594, "juz": 30}, "19": {"uthmani": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ", "simple": "والذين كفروا بآياتنا هم أصحاب المشأمة", "page": 594, "juz": 30}, "20": {"uthmani": "عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ", "simple": "عليهم نار مؤصدة", "page": 594, "juz": 30}}}