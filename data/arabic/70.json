{"surah": 70, "ayahs": {"1": {"uthmani": "سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ", "simple": "سأل سائل بعذاب واقع", "page": 568, "juz": 29}, "2": {"uthmani": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ", "simple": "للكافرين ليس له دافع", "page": 568, "juz": 29}, "3": {"uthmani": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ", "simple": "من الله ذي المعارج", "page": 568, "juz": 29}, "4": {"uthmani": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ", "simple": "تعرج الملائكة والروح إليه في يوم كان مقداره خمسين ألف سنة", "page": 568, "juz": 29}, "5": {"uthmani": "فَٱصْبِرْ صَبْرًۭا جَمِيلًا", "simple": "فاصبر صبرا جميلا", "page": 568, "juz": 29}, "6": {"uthmani": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا", "simple": "إنهم يرونه بعيدا", "page": 568, "juz": 29}, "7": {"uthmani": "وَنَرَىٰهُ قَرِيبًۭا", "simple": "ونراه قريبا", "page": 568, "juz": 29}, "8": {"uthmani": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ", "simple": "يوم تكون السماء كالمهل", "page": 568, "juz": 29}, "9": {"uthmani": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ", "simple": "وتكون الجبال كالعهن", "page": 568, "juz": 29}, "10": {"uthmani": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا", "simple": "ولا يسأل حميم حميما", "page": 568, "juz": 29}, "11": {"uthmani": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ", "simple": "يبصرونهم ۚ يود المجرم لو يفتدي من عذاب يومئذ ببنيه", "page": 569, "juz": 29}, "12": {"uthmani": "وَصَٰحِبَتِهِۦ وَأَخِيهِ", "simple": "وصاحبته وأخيه", "page": 569, "juz": 29}, "13": {"uthmani": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ", "simple": "وفصيلته التي تؤويه", "page": 569, "juz": 29}, "14": {"uthmani": "وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ", "simple": "ومن في الأرض جميعا ثم ينجيه", "page": 569, "juz": 29}, "15": {"uthmani": "كَلَّآ ۖ إِنَّهَا لَظَىٰ", "simple": "كلا ۖ إنها لظى", "page": 569, "juz": 29}, "16": {"uthmani": "نَزَّاعَةًۭ لِّلشَّوَىٰ", "simple": "نزاعة للشوى", "page": 569, "juz": 29}, "17": {"uthmani": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ", "simple": "تدعو من أدبر وتولى", "page": 569, "juz": 29}, "18": {"uthmani": "وَجَمَعَ فَأَوْعَىٰٓ", "simple": "وجمع فأوعى", "page": 569, "juz": 29}, "19": {"uthmani": "۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا", "simple": "۞ إن الإنسان خلق هلوعا", "page": 569, "juz": 29}, "20": {"uthmani": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًۭا", "simple": "إذا مسه الشر جزوعا", "page": 569, "juz": 29}, "21": {"uthmani": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا", "simple": "وإذا مسه الخير منوعا", "page": 569, "juz": 29}, "22": {"uthmani": "إِلَّا ٱلْمُصَلِّينَ", "simple": "إلا المصلين", "page": 569, "juz": 29}, "23": {"uthmani": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ", "simple": "الذين هم على صلاتهم دائمون", "page": 569, "juz": 29}, "24": {"uthmani": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّۭ مَّعْلُومٌۭ", "simple": "والذين في أموالهم حق معلوم", "page": 569, "juz": 29}, "25": {"uthmani": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ", "simple": "للسائل والمحروم", "page": 569, "juz": 29}, "26": {"uthmani": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ", "simple": "والذين يصدقون بيوم الدين", "page": 569, "juz": 29}, "27": {"uthmani": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ", "simple": "والذين هم من عذاب ربهم مشفقون", "page": 569, "juz": 29}, "28": {"uthmani": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۢ", "simple": "إن عذاب ربهم غير مأمون", "page": 569, "juz": 29}, "29": {"uthmani": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ", "simple": "والذين هم لفروجهم حافظون", "page": 569, "juz": 29}, "30": {"uthmani": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ", "simple": "إلا على أزواجهم أو ما ملكت أيمانهم فإنهم غير ملومين", "page": 569, "juz": 29}, "31": {"uthmani": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ", "simple": "فمن ابتغى وراء ذلك فأولئك هم العادون", "page": 569, "juz": 29}, "32": {"uthmani": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ", "simple": "والذين هم لأماناتهم وعهدهم راعون", "page": 569, "juz": 29}, "33": {"uthmani": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ", "simple": "والذين هم بشهاداتهم قائمون", "page": 569, "juz": 29}, "34": {"uthmani": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ", "simple": "والذين هم على صلاتهم يحافظون", "page": 569, "juz": 29}, "35": {"uthmani": "أُو۟لَٰٓئِكَ فِى جَنَّٰتٍۢ مُّكْرَمُونَ", "simple": "أولئك في جنات مكرمون", "page": 569, "juz": 29}, "36": {"uthmani": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ", "simple": "فمال الذين كفروا قبلك مهطعين", "page": 569, "juz": 29}, "37": {"uthmani": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ", "simple": "عن اليمين وعن الشمال عزين", "page": 569, "juz": 29}, "38": {"uthmani": "أَيَطْمَعُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍۢ", "simple": "أيطمع كل امرئ منهم أن يدخل جنة نعيم", "page": 569, "juz": 29}, "39": {"uthmani": "كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ", "simple": "كلا ۖ إنا خلقناهم مما يعلمون", "page": 569, "juz": 29}, "40": {"uthmani": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ", "simple": "فلا أقسم برب المشارق والمغارب إنا لقادرون", "page": 570, "juz": 29}, "41": {"uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًۭا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ", "simple": "على أن نبدل خيرا منهم وما نحن بمسبوقين", "page": 570, "juz": 29}, "42": {"uthmani": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ", "simple": "فذرهم يخوضوا ويلعبوا حتى يلاقوا يومهم الذي يوعدون", "page": 570, "juz": 29}, "43": {"uthmani": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًۭا كَأَنَّهُمْ إِلَىٰ نُصُبٍۢ يُوفِضُونَ", "simple": "يوم يخرجون من الأجداث سراعا كأنهم إلى نصب يوفضون", "page": 570, "juz": 29}, "44": {"uthmani": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ", "simple": "خاشعة أبصارهم ترهقهم ذلة ۚ ذلك اليوم الذي كانوا يوعدون", "page": 570, "juz": 29}}}