{"surah": 89, "ayahs": {"1": {"uthmani": "وَٱلْفَجْرِ", "simple": "والفجر", "page": 593, "juz": 30}, "2": {"uthmani": "وَلَيَالٍ عَشْرٍۢ", "simple": "وليال عشر", "page": 593, "juz": 30}, "3": {"uthmani": "وَٱلشَّفْعِ وَٱلْوَتْرِ", "simple": "والشفع والوتر", "page": 593, "juz": 30}, "4": {"uthmani": "وَٱلَّيْلِ إِذَا يَسْرِ", "simple": "والليل إذا يسر", "page": 593, "juz": 30}, "5": {"uthmani": "هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ", "simple": "هل في ذلك قسم لذي حجر", "page": 593, "juz": 30}, "6": {"uthmani": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ", "simple": "ألم تر كيف فعل ربك بعاد", "page": 593, "juz": 30}, "7": {"uthmani": "إِرَمَ ذَاتِ ٱلْعِمَادِ", "simple": "إرم ذات العماد", "page": 593, "juz": 30}, "8": {"uthmani": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ", "simple": "التي لم يخلق مثلها في البلاد", "page": 593, "juz": 30}, "9": {"uthmani": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ", "simple": "وثمود الذين جابوا الصخر بالواد", "page": 593, "juz": 30}, "10": {"uthmani": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ", "simple": "وفرعون ذي الأوتاد", "page": 593, "juz": 30}, "11": {"uthmani": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ", "simple": "الذين طغوا في البلاد", "page": 593, "juz": 30}, "12": {"uthmani": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ", "simple": "فأكثروا فيها الفساد", "page": 593, "juz": 30}, "13": {"uthmani": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ", "simple": "فصب عليهم ربك سوط عذاب", "page": 593, "juz": 30}, "14": {"uthmani": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ", "simple": "إن ربك لبالمرصاد", "page": 593, "juz": 30}, "15": {"uthmani": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ", "simple": "فأما الإنسان إذا ما ابتلاه ربه فأكرمه ونعمه فيقول ربي أكرمن", "page": 593, "juz": 30}, "16": {"uthmani": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ", "simple": "وأما إذا ما ابتلاه فقدر عليه رزقه فيقول ربي أهانن", "page": 593, "juz": 30}, "17": {"uthmani": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ", "simple": "كلا ۖ بل لا تكرمون اليتيم", "page": 593, "juz": 30}, "18": {"uthmani": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "simple": "ولا تحاضون على طعام المسكين", "page": 593, "juz": 30}, "19": {"uthmani": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا", "simple": "وتأكلون التراث أكلا لما", "page": 593, "juz": 30}, "20": {"uthmani": "وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا", "simple": "وتحبون المال حبا جما", "page": 593, "juz": 30}, "21": {"uthmani": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا", "simple": "كلا إذا دكت الأرض دكا دكا", "page": 593, "juz": 30}, "22": {"uthmani": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا", "simple": "وجاء ربك والملك صفا صفا", "page": 593, "juz": 30}, "23": {"uthmani": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ", "simple": "وجيء يومئذ بجهنم ۚ يومئذ يتذكر الإنسان وأنى له الذكرى", "page": 593, "juz": 30}, "24": {"uthmani": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى", "simple": "يقول يا ليتني قدمت لحياتي", "page": 594, "juz": 30}, "25": {"uthmani": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ", "simple": "فيومئذ لا يعذب عذابه أحد", "page": 594, "juz": 30}, "26": {"uthmani": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ", "simple": "ولا يوثق وثاقه أحد", "page": 594, "juz": 30}, "27": {"uthmani": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ", "simple": "يا أيتها النفس المطمئنة", "page": 594, "juz": 30}, "28": {"uthmani": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ", "simple": "ارجعي إلى ربك راضية مرضية", "page": 594, "juz": 30}, "29": {"uthmani": "فَٱدْخُلِى فِى عِبَٰدِى", "simple": "فادخلي في عبادي", "page": 594, "juz": 30}, "30": {"uthmani": "وَٱدْخُلِى جَنَّتِى", "simple": "وادخلي جنتي", "page": 594, "juz": 30}}}