{"surah": 94, "ayahs": {"1": {"uthmani": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ", "simple": "ألم نشرح لك صدرك", "page": 596, "juz": 30}, "2": {"uthmani": "وَوَضَعْنَا عَنكَ وِزْرَكَ", "simple": "ووضعنا عنك وزرك", "page": 596, "juz": 30}, "3": {"uthmani": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ", "simple": "الذي أنقض ظهرك", "page": 596, "juz": 30}, "4": {"uthmani": "وَرَفَعْنَا لَكَ ذِكْرَكَ", "simple": "ورفعنا لك ذكرك", "page": 596, "juz": 30}, "5": {"uthmani": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا", "simple": "فإن مع العسر يسرا", "page": 596, "juz": 30}, "6": {"uthmani": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا", "simple": "إن مع العسر يسرا", "page": 596, "juz": 30}, "7": {"uthmani": "فَإِذَا فَرَغْتَ فَٱنصَبْ", "simple": "فإذا فرغت فانصب", "page": 596, "juz": 30}, "8": {"uthmani": "وَإِلَىٰ رَبِّكَ فَٱرْغَب", "simple": "وإلى ربك فارغب", "page": 596, "juz": 30}}}