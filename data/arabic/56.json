{"surah": 56, "ayahs": {"1": {"uthmani": "إِذَا وَقَعَتِ ٱلْوَاقِعَةُ", "simple": "إذا وقعت الواقعة", "page": 534, "juz": 27}, "2": {"uthmani": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ", "simple": "ليس لوقعتها كاذبة", "page": 534, "juz": 27}, "3": {"uthmani": "خَافِضَةٌۭ رَّافِعَةٌ", "simple": "خافضة رافعة", "page": 534, "juz": 27}, "4": {"uthmani": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا", "simple": "إذا رجت الأرض رجا", "page": 534, "juz": 27}, "5": {"uthmani": "وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا", "simple": "وبست الجبال بسا", "page": 534, "juz": 27}, "6": {"uthmani": "فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا", "simple": "فكانت هباء منبثا", "page": 534, "juz": 27}, "7": {"uthmani": "وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ", "simple": "وكنتم أزواجا ثلاثة", "page": 534, "juz": 27}, "8": {"uthmani": "فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ", "simple": "فأصحاب الميمنة ما أصحاب الميمنة", "page": 534, "juz": 27}, "9": {"uthmani": "وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ", "simple": "وأصحاب المشأمة ما أصحاب المشأمة", "page": 534, "juz": 27}, "10": {"uthmani": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ", "simple": "والسابقون السابقون", "page": 534, "juz": 27}, "11": {"uthmani": "أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ", "simple": "أولئك المقربون", "page": 534, "juz": 27}, "12": {"uthmani": "فِى جَنَّٰتِ ٱلنَّعِيمِ", "simple": "في جنات النعيم", "page": 534, "juz": 27}, "13": {"uthmani": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ", "simple": "ثلة من الأولين", "page": 534, "juz": 27}, "14": {"uthmani": "وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ", "simple": "وقليل من الآخرين", "page": 534, "juz": 27}, "15": {"uthmani": "عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ", "simple": "على سرر موضونة", "page": 534, "juz": 27}, "16": {"uthmani": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ", "simple": "متكئين عليها متقابلين", "page": 534, "juz": 27}, "17": {"uthmani": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ", "simple": "يطوف عليهم ولدان مخلدون", "page": 535, "juz": 27}, "18": {"uthmani": "بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ", "simple": "بأكواب وأباريق وكأس من معين", "page": 535, "juz": 27}, "19": {"uthmani": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ", "simple": "لا يصدعون عنها ولا ينزفون", "page": 535, "juz": 27}, "20": {"uthmani": "وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ", "simple": "وفاكهة مما يتخيرون", "page": 535, "juz": 27}, "21": {"uthmani": "وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ", "simple": "ولحم طير مما يشتهون", "page": 535, "juz": 27}, "22": {"uthmani": "وَحُورٌ عِينٌۭ", "simple": "وحور عين", "page": 535, "juz": 27}, "23": {"uthmani": "كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ", "simple": "كأمثال اللؤلؤ المكنون", "page": 535, "juz": 27}, "24": {"uthmani": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ", "simple": "جزاء بما كانوا يعملون", "page": 535, "juz": 27}, "25": {"uthmani": "لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا", "simple": "لا يسمعون فيها لغوا ولا تأثيما", "page": 535, "juz": 27}, "26": {"uthmani": "إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا", "simple": "إلا قيلا سلاما سلاما", "page": 535, "juz": 27}, "27": {"uthmani": "وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ", "simple": "وأصحاب اليمين ما أصحاب اليمين", "page": 535, "juz": 27}, "28": {"uthmani": "فِى سِدْرٍۢ مَّخْضُودٍۢ", "simple": "في سدر مخضود", "page": 535, "juz": 27}, "29": {"uthmani": "وَطَلْحٍۢ مَّنضُودٍۢ", "simple": "وطلح منضود", "page": 535, "juz": 27}, "30": {"uthmani": "وَظِلٍّۢ مَّمْدُودٍۢ", "simple": "وظل ممدود", "page": 535, "juz": 27}, "31": {"uthmani": "وَمَآءٍۢ مَّسْكُوبٍۢ", "simple": "وماء مسكوب", "page": 535, "juz": 27}, "32": {"uthmani": "وَفَٰكِهَةٍۢ كَثِيرَةٍۢ", "simple": "وفاكهة كثيرة", "page": 535, "juz": 27}, "33": {"uthmani": "لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ", "simple": "لا مقطوعة ولا ممنوعة", "page": 535, "juz": 27}, "34": {"uthmani": "وَفُرُشٍۢ مَّرْفُوعَةٍ", "simple": "وفرش مرفوعة", "page": 535, "juz": 27}, "35": {"uthmani": "إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ", "simple": "إنا أنشأناهن إنشاء", "page": 535, "juz": 27}, "36": {"uthmani": "فَجَعَلْنَٰهُنَّ أَبْكَارًا", "simple": "فجعلناهن أبكارا", "page": 535, "juz": 27}, "37": {"uthmani": "عُرُبًا أَتْرَابًۭا", "simple": "عربا أترابا", "page": 535, "juz": 27}, "38": {"uthmani": "لِّأَصْحَٰبِ ٱلْيَمِينِ", "simple": "لأصحاب اليمين", "page": 535, "juz": 27}, "39": {"uthmani": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ", "simple": "ثلة من الأولين", "page": 535, "juz": 27}, "40": {"uthmani": "وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ", "simple": "وثلة من الآخرين", "page": 535, "juz": 27}, "41": {"uthmani": "وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ", "simple": "وأصحاب الشمال ما أصحاب الشمال", "page": 535, "juz": 27}, "42": {"uthmani": "فِى سَمُومٍۢ وَحَمِيمٍۢ", "simple": "في سموم وحميم", "page": 535, "juz": 27}, "43": {"uthmani": "وَظِلٍّۢ مِّن يَحْمُومٍۢ", "simple": "وظل من يحموم", "page": 535, "juz": 27}, "44": {"uthmani": "لَّا بَارِدٍۢ وَلَا كَرِيمٍ", "simple": "لا بارد ولا كريم", "page": 535, "juz": 27}, "45": {"uthmani": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ", "simple": "إنهم كانوا قبل ذلك مترفين", "page": 535, "juz": 27}, "46": {"uthmani": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ", "simple": "وكانوا يصرون على الحنث العظيم", "page": 535, "juz": 27}, "47": {"uthmani": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ", "simple": "وكانوا يقولون أئذا متنا وكنا ترابا وعظاما أإنا لمبعوثون", "page": 535, "juz": 27}, "48": {"uthmani": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ", "simple": "أوآباؤنا الأولون", "page": 535, "juz": 27}, "49": {"uthmani": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ", "simple": "قل إن الأولين والآخرين", "page": 535, "juz": 27}, "50": {"uthmani": "لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ", "simple": "لمجموعون إلى ميقات يوم معلوم", "page": 535, "juz": 27}, "51": {"uthmani": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ", "simple": "ثم إنكم أيها الضالون المكذبون", "page": 536, "juz": 27}, "52": {"uthmani": "لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ", "simple": "لآكلون من شجر من زقوم", "page": 536, "juz": 27}, "53": {"uthmani": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ", "simple": "فمالئون منها البطون", "page": 536, "juz": 27}, "54": {"uthmani": "فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ", "simple": "فشاربون عليه من الحميم", "page": 536, "juz": 27}, "55": {"uthmani": "فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ", "simple": "فشاربون شرب الهيم", "page": 536, "juz": 27}, "56": {"uthmani": "هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ", "simple": "هذا نزلهم يوم الدين", "page": 536, "juz": 27}, "57": {"uthmani": "نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ", "simple": "نحن خلقناكم فلولا تصدقون", "page": 536, "juz": 27}, "58": {"uthmani": "أَفَرَءَيْتُم مَّا تُمْنُونَ", "simple": "أفرأيتم ما تمنون", "page": 536, "juz": 27}, "59": {"uthmani": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ", "simple": "أأنتم تخلقونه أم نحن الخالقون", "page": 536, "juz": 27}, "60": {"uthmani": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ", "simple": "نحن قدرنا بينكم الموت وما نحن بمسبوقين", "page": 536, "juz": 27}, "61": {"uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ", "simple": "على أن نبدل أمثالكم وننشئكم في ما لا تعلمون", "page": 536, "juz": 27}, "62": {"uthmani": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ", "simple": "ولقد علمتم النشأة الأولى فلولا تذكرون", "page": 536, "juz": 27}, "63": {"uthmani": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ", "simple": "أفرأيتم ما تحرثون", "page": 536, "juz": 27}, "64": {"uthmani": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ", "simple": "أأنتم تزرعونه أم نحن الزارعون", "page": 536, "juz": 27}, "65": {"uthmani": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ", "simple": "لو نشاء لجعلناه حطاما فظلتم تفكهون", "page": 536, "juz": 27}, "66": {"uthmani": "إِنَّا لَمُغْرَمُونَ", "simple": "إنا لمغرمون", "page": 536, "juz": 27}, "67": {"uthmani": "بَلْ نَحْنُ مَحْرُومُونَ", "simple": "بل نحن محرومون", "page": 536, "juz": 27}, "68": {"uthmani": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ", "simple": "أفرأيتم الماء الذي تشربون", "page": 536, "juz": 27}, "69": {"uthmani": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ", "simple": "أأنتم أنزلتموه من المزن أم نحن المنزلون", "page": 536, "juz": 27}, "70": {"uthmani": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ", "simple": "لو نشاء جعلناه أجاجا فلولا تشكرون", "page": 536, "juz": 27}, "71": {"uthmani": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ", "simple": "أفرأيتم النار التي تورون", "page": 536, "juz": 27}, "72": {"uthmani": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ", "simple": "أأنتم أنشأتم شجرتها أم نحن المنشئون", "page": 536, "juz": 27}, "73": {"uthmani": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ", "simple": "نحن جعلناها تذكرة ومتاعا للمقوين", "page": 536, "juz": 27}, "74": {"uthmani": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ", "simple": "فسبح باسم ربك العظيم", "page": 536, "juz": 27}, "75": {"uthmani": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ", "simple": "۞ فلا أقسم بمواقع النجوم", "page": 536, "juz": 27}, "76": {"uthmani": "وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ", "simple": "وإنه لقسم لو تعلمون عظيم", "page": 536, "juz": 27}, "77": {"uthmani": "إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ", "simple": "إنه لقرآن كريم", "page": 537, "juz": 27}, "78": {"uthmani": "فِى كِتَٰبٍۢ مَّكْنُونٍۢ", "simple": "في كتاب مكنون", "page": 537, "juz": 27}, "79": {"uthmani": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ", "simple": "لا يمسه إلا المطهرون", "page": 537, "juz": 27}, "80": {"uthmani": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ", "simple": "تنزيل من رب العالمين", "page": 537, "juz": 27}, "81": {"uthmani": "أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ", "simple": "أفبهذا الحديث أنتم مدهنون", "page": 537, "juz": 27}, "82": {"uthmani": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ", "simple": "وتجعلون رزقكم أنكم تكذبون", "page": 537, "juz": 27}, "83": {"uthmani": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ", "simple": "فلولا إذا بلغت الحلقوم", "page": 537, "juz": 27}, "84": {"uthmani": "وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ", "simple": "وأنتم حينئذ تنظرون", "page": 537, "juz": 27}, "85": {"uthmani": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ", "simple": "ونحن أقرب إليه منكم ولكن لا تبصرون", "page": 537, "juz": 27}, "86": {"uthmani": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ", "simple": "فلولا إن كنتم غير مدينين", "page": 537, "juz": 27}, "87": {"uthmani": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ", "simple": "ترجعونها إن كنتم صادقين", "page": 537, "juz": 27}, "88": {"uthmani": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ", "simple": "فأما إن كان من المقربين", "page": 537, "juz": 27}, "89": {"uthmani": "فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ", "simple": "فروح وريحان وجنت نعيم", "page": 537, "juz": 27}, "90": {"uthmani": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ", "simple": "وأما إن كان من أصحاب اليمين", "page": 537, "juz": 27}, "91": {"uthmani": "فَسَلَٰمٌۭ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ", "simple": "فسلام لك من أصحاب اليمين", "page": 537, "juz": 27}, "92": {"uthmani": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ", "simple": "وأما إن كان من المكذبين الضالين", "page": 537, "juz": 27}, "93": {"uthmani": "فَنُزُلٌۭ مِّنْ حَمِيمٍۢ", "simple": "فنزل من حميم", "page": 537, "juz": 27}, "94": {"uthmani": "وَتَصْلِيَةُ جَحِيمٍ", "simple": "وتصلية جحيم", "page": 537, "juz": 27}, "95": {"uthmani": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ", "simple": "إن هذا لهو حق اليقين", "page": 537, "juz": 27}, "96": {"uthmani": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ", "simple": "فسبح باسم ربك العظيم", "page": 537, "juz": 27}}}