{"surah": 95, "ayahs": {"1": {"uthmani": "وَٱلتِّينِ وَٱلزَّيْتُونِ", "simple": "والتين والزيتون", "page": 597, "juz": 30}, "2": {"uthmani": "وَطُورِ سِينِينَ", "simple": "وطور سينين", "page": 597, "juz": 30}, "3": {"uthmani": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ", "simple": "وهذا البلد الأمين", "page": 597, "juz": 30}, "4": {"uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ", "simple": "لقد خلقنا الإنسان في أحسن تقويم", "page": 597, "juz": 30}, "5": {"uthmani": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ", "simple": "ثم رددناه أسفل سافلين", "page": 597, "juz": 30}, "6": {"uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ", "simple": "إلا الذين آمنوا وعملوا الصالحات فلهم أجر غير ممنون", "page": 597, "juz": 30}, "7": {"uthmani": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ", "simple": "فما يكذبك بعد بالدين", "page": 597, "juz": 30}, "8": {"uthmani": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ", "simple": "أليس الله بأحكم الحاكمين", "page": 597, "juz": 30}}}