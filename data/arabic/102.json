{"surah": 102, "ayahs": {"1": {"uthmani": "أَلْهَىٰكُمُ ٱلتَّكَاثُرُ", "simple": "ألهاكم التكاثر", "page": 600, "juz": 30}, "2": {"uthmani": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ", "simple": "حتى زرتم المقابر", "page": 600, "juz": 30}, "3": {"uthmani": "كَلَّا سَوْفَ تَعْلَمُونَ", "simple": "كلا سوف تعلمون", "page": 600, "juz": 30}, "4": {"uthmani": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ", "simple": "ثم كلا سوف تعلمون", "page": 600, "juz": 30}, "5": {"uthmani": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ", "simple": "كلا لو تعلمون علم اليقين", "page": 600, "juz": 30}, "6": {"uthmani": "لَتَرَوُنَّ ٱلْجَحِيمَ", "simple": "لترون الجحيم", "page": 600, "juz": 30}, "7": {"uthmani": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ", "simple": "ثم لترونها عين اليقين", "page": 600, "juz": 30}, "8": {"uthmani": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ", "simple": "ثم لتسألن يومئذ عن النعيم", "page": 600, "juz": 30}}}