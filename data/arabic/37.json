{"surah": 37, "ayahs": {"1": {"uthmani": "وَٱلصَّٰٓفَّٰتِ صَفًّۭا", "simple": "والصافات صفا", "page": 446, "juz": 23}, "2": {"uthmani": "فَٱلزَّٰجِرَٰتِ زَجْرًۭا", "simple": "فالزاجرات زجرا", "page": 446, "juz": 23}, "3": {"uthmani": "فَٱلتَّٰلِيَٰتِ ذِكْرًا", "simple": "فالتاليات ذكرا", "page": 446, "juz": 23}, "4": {"uthmani": "إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌۭ", "simple": "إن إلهكم لواحد", "page": 446, "juz": 23}, "5": {"uthmani": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ", "simple": "رب السماوات والأرض وما بينهما ورب المشارق", "page": 446, "juz": 23}, "6": {"uthmani": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ", "simple": "إنا زينا السماء الدنيا بزينة الكواكب", "page": 446, "juz": 23}, "7": {"uthmani": "وَحِفْظًۭا مِّن كُلِّ شَيْطَٰنٍۢ مَّارِدٍۢ", "simple": "وحفظا من كل شيطان مارد", "page": 446, "juz": 23}, "8": {"uthmani": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍۢ", "simple": "لا يسمعون إلى الملإ الأعلى ويقذفون من كل جانب", "page": 446, "juz": 23}, "9": {"uthmani": "دُحُورًۭا ۖ وَلَهُمْ عَذَابٌۭ وَاصِبٌ", "simple": "دحورا ۖ ولهم عذاب واصب", "page": 446, "juz": 23}, "10": {"uthmani": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌۭ ثَاقِبٌۭ", "simple": "إلا من خطف الخطفة فأتبعه شهاب ثاقب", "page": 446, "juz": 23}, "11": {"uthmani": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَٰهُم مِّن طِينٍۢ لَّازِبٍۭ", "simple": "فاستفتهم أهم أشد خلقا أم من خلقنا ۚ إنا خلقناهم من طين لازب", "page": 446, "juz": 23}, "12": {"uthmani": "بَلْ عَجِبْتَ وَيَسْخَرُونَ", "simple": "بل عجبت ويسخرون", "page": 446, "juz": 23}, "13": {"uthmani": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ", "simple": "وإذا ذكروا لا يذكرون", "page": 446, "juz": 23}, "14": {"uthmani": "وَإِذَا رَأَوْا۟ ءَايَةًۭ يَسْتَسْخِرُونَ", "simple": "وإذا رأوا آية يستسخرون", "page": 446, "juz": 23}, "15": {"uthmani": "وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ مُّبِينٌ", "simple": "وقالوا إن هذا إلا سحر مبين", "page": 446, "juz": 23}, "16": {"uthmani": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ", "simple": "أإذا متنا وكنا ترابا وعظاما أإنا لمبعوثون", "page": 446, "juz": 23}, "17": {"uthmani": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ", "simple": "أوآباؤنا الأولون", "page": 446, "juz": 23}, "18": {"uthmani": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ", "simple": "قل نعم وأنتم داخرون", "page": 446, "juz": 23}, "19": {"uthmani": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ فَإِذَا هُمْ يَنظُرُونَ", "simple": "فإنما هي زجرة واحدة فإذا هم ينظرون", "page": 446, "juz": 23}, "20": {"uthmani": "وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ", "simple": "وقالوا يا ويلنا هذا يوم الدين", "page": 446, "juz": 23}, "21": {"uthmani": "هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ", "simple": "هذا يوم الفصل الذي كنتم به تكذبون", "page": 446, "juz": 23}, "22": {"uthmani": "۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ", "simple": "۞ احشروا الذين ظلموا وأزواجهم وما كانوا يعبدون", "page": 446, "juz": 23}, "23": {"uthmani": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ", "simple": "من دون الله فاهدوهم إلى صراط الجحيم", "page": 446, "juz": 23}, "24": {"uthmani": "وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ", "simple": "وقفوهم ۖ إنهم مسئولون", "page": 446, "juz": 23}, "25": {"uthmani": "مَا لَكُمْ لَا تَنَاصَرُونَ", "simple": "ما لكم لا تناصرون", "page": 447, "juz": 23}, "26": {"uthmani": "بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ", "simple": "بل هم اليوم مستسلمون", "page": 447, "juz": 23}, "27": {"uthmani": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ", "simple": "وأقبل بعضهم على بعض يتساءلون", "page": 447, "juz": 23}, "28": {"uthmani": "قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ", "simple": "قالوا إنكم كنتم تأتوننا عن اليمين", "page": 447, "juz": 23}, "29": {"uthmani": "قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ", "simple": "قالوا بل لم تكونوا مؤمنين", "page": 447, "juz": 23}, "30": {"uthmani": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًۭا طَٰغِينَ", "simple": "وما كان لنا عليكم من سلطان ۖ بل كنتم قوما طاغين", "page": 447, "juz": 23}, "31": {"uthmani": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ", "simple": "فحق علينا قول ربنا ۖ إنا لذائقون", "page": 447, "juz": 23}, "32": {"uthmani": "فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ", "simple": "فأغويناكم إنا كنا غاوين", "page": 447, "juz": 23}, "33": {"uthmani": "فَإِنَّهُمْ يَوْمَئِذٍۢ فِى ٱلْعَذَابِ مُشْتَرِكُونَ", "simple": "فإنهم يومئذ في العذاب مشتركون", "page": 447, "juz": 23}, "34": {"uthmani": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ", "simple": "إنا كذلك نفعل بالمجرمين", "page": 447, "juz": 23}, "35": {"uthmani": "إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ", "simple": "إنهم كانوا إذا قيل لهم لا إله إلا الله يستكبرون", "page": 447, "juz": 23}, "36": {"uthmani": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍۢ مَّجْنُونٍۭ", "simple": "ويقولون أئنا لتاركو آلهتنا لشاعر مجنون", "page": 447, "juz": 23}, "37": {"uthmani": "بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ", "simple": "بل جاء بالحق وصدق المرسلين", "page": 447, "juz": 23}, "38": {"uthmani": "إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ", "simple": "إنكم لذائقو العذاب الأليم", "page": 447, "juz": 23}, "39": {"uthmani": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ", "simple": "وما تجزون إلا ما كنتم تعملون", "page": 447, "juz": 23}, "40": {"uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ", "simple": "إلا عباد الله المخلصين", "page": 447, "juz": 23}, "41": {"uthmani": "أُو۟لَٰٓئِكَ لَهُمْ رِزْقٌۭ مَّعْلُومٌۭ", "simple": "أولئك لهم رزق معلوم", "page": 447, "juz": 23}, "42": {"uthmani": "فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ", "simple": "فواكه ۖ وهم مكرمون", "page": 447, "juz": 23}, "43": {"uthmani": "فِى جَنَّٰتِ ٱلنَّعِيمِ", "simple": "في جنات النعيم", "page": 447, "juz": 23}, "44": {"uthmani": "عَلَىٰ سُرُرٍۢ مُّتَقَٰبِلِينَ", "simple": "على سرر متقابلين", "page": 447, "juz": 23}, "45": {"uthmani": "يُطَافُ عَلَيْهِم بِكَأْسٍۢ مِّن مَّعِينٍۭ", "simple": "يطاف عليهم بكأس من معين", "page": 447, "juz": 23}, "46": {"uthmani": "بَيْضَآءَ لَذَّةٍۢ لِّلشَّٰرِبِينَ", "simple": "بيضاء لذة للشاربين", "page": 447, "juz": 23}, "47": {"uthmani": "لَا فِيهَا غَوْلٌۭ وَلَا هُمْ عَنْهَا يُنزَفُونَ", "simple": "لا فيها غول ولا هم عنها ينزفون", "page": 447, "juz": 23}, "48": {"uthmani": "وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌۭ", "simple": "وعندهم قاصرات الطرف عين", "page": 447, "juz": 23}, "49": {"uthmani": "كَأَنَّهُنَّ بَيْضٌۭ مَّكْنُونٌۭ", "simple": "كأنهن بيض مكنون", "page": 447, "juz": 23}, "50": {"uthmani": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ", "simple": "فأقبل بعضهم على بعض يتساءلون", "page": 447, "juz": 23}, "51": {"uthmani": "قَالَ قَآئِلٌۭ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌۭ", "simple": "قال قائل منهم إني كان لي قرين", "page": 447, "juz": 23}, "52": {"uthmani": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ", "simple": "يقول أإنك لمن المصدقين", "page": 448, "juz": 23}, "53": {"uthmani": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ", "simple": "أإذا متنا وكنا ترابا وعظاما أإنا لمدينون", "page": 448, "juz": 23}, "54": {"uthmani": "قَالَ هَلْ أَنتُم مُّطَّلِعُونَ", "simple": "قال هل أنتم مطلعون", "page": 448, "juz": 23}, "55": {"uthmani": "فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ", "simple": "فاطلع فرآه في سواء الجحيم", "page": 448, "juz": 23}, "56": {"uthmani": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ", "simple": "قال تالله إن كدت لتردين", "page": 448, "juz": 23}, "57": {"uthmani": "وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ", "simple": "ولولا نعمة ربي لكنت من المحضرين", "page": 448, "juz": 23}, "58": {"uthmani": "أَفَمَا نَحْنُ بِمَيِّتِينَ", "simple": "أفما نحن بميتين", "page": 448, "juz": 23}, "59": {"uthmani": "إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ", "simple": "إلا موتتنا الأولى وما نحن بمعذبين", "page": 448, "juz": 23}, "60": {"uthmani": "إِنَّ هَٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ", "simple": "إن هذا لهو الفوز العظيم", "page": 448, "juz": 23}, "61": {"uthmani": "لِمِثْلِ هَٰذَا فَلْيَعْمَلِ ٱلْعَٰمِلُونَ", "simple": "لمثل هذا فليعمل العاملون", "page": 448, "juz": 23}, "62": {"uthmani": "أَذَٰلِكَ خَيْرٌۭ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ", "simple": "أذلك خير نزلا أم شجرة الزقوم", "page": 448, "juz": 23}, "63": {"uthmani": "إِنَّا جَعَلْنَٰهَا فِتْنَةًۭ لِّلظَّٰلِمِينَ", "simple": "إنا جعلناها فتنة للظالمين", "page": 448, "juz": 23}, "64": {"uthmani": "إِنَّهَا شَجَرَةٌۭ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ", "simple": "إنها شجرة تخرج في أصل الجحيم", "page": 448, "juz": 23}, "65": {"uthmani": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ", "simple": "طلعها كأنه رءوس الشياطين", "page": 448, "juz": 23}, "66": {"uthmani": "فَإِنَّهُمْ لَءَاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ", "simple": "فإنهم لآكلون منها فمالئون منها البطون", "page": 448, "juz": 23}, "67": {"uthmani": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًۭا مِّنْ حَمِيمٍۢ", "simple": "ثم إن لهم عليها لشوبا من حميم", "page": 448, "juz": 23}, "68": {"uthmani": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ", "simple": "ثم إن مرجعهم لإلى الجحيم", "page": 448, "juz": 23}, "69": {"uthmani": "إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ", "simple": "إنهم ألفوا آباءهم ضالين", "page": 448, "juz": 23}, "70": {"uthmani": "فَهُمْ عَلَىٰٓ ءَاثَٰرِهِمْ يُهْرَعُونَ", "simple": "فهم على آثارهم يهرعون", "page": 448, "juz": 23}, "71": {"uthmani": "وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ", "simple": "ولقد ضل قبلهم أكثر الأولين", "page": 448, "juz": 23}, "72": {"uthmani": "وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ", "simple": "ولقد أرسلنا فيهم منذرين", "page": 448, "juz": 23}, "73": {"uthmani": "فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُنذَرِينَ", "simple": "فانظر كيف كان عاقبة المنذرين", "page": 448, "juz": 23}, "74": {"uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ", "simple": "إلا عباد الله المخلصين", "page": 448, "juz": 23}, "75": {"uthmani": "وَلَقَدْ نَادَىٰنَا نُوحٌۭ فَلَنِعْمَ ٱلْمُجِيبُونَ", "simple": "ولقد نادانا نوح فلنعم المجيبون", "page": 448, "juz": 23}, "76": {"uthmani": "وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ", "simple": "ونجيناه وأهله من الكرب العظيم", "page": 448, "juz": 23}, "77": {"uthmani": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ", "simple": "وجعلنا ذريته هم الباقين", "page": 449, "juz": 23}, "78": {"uthmani": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ", "simple": "وتركنا عليه في الآخرين", "page": 449, "juz": 23}, "79": {"uthmani": "سَلَٰمٌ عَلَىٰ نُوحٍۢ فِى ٱلْعَٰلَمِينَ", "simple": "سلام على نوح في العالمين", "page": 449, "juz": 23}, "80": {"uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "simple": "إنا كذلك نجزي المحسنين", "page": 449, "juz": 23}, "81": {"uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ", "simple": "إنه من عبادنا المؤمنين", "page": 449, "juz": 23}, "82": {"uthmani": "ثُمَّ أَغْرَقْنَا ٱلْءَاخَرِينَ", "simple": "ثم أغرقنا الآخرين", "page": 449, "juz": 23}, "83": {"uthmani": "۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ", "simple": "۞ وإن من شيعته لإبراهيم", "page": 449, "juz": 23}, "84": {"uthmani": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍۢ سَلِيمٍ", "simple": "إذ جاء ربه بقلب سليم", "page": 449, "juz": 23}, "85": {"uthmani": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ", "simple": "إذ قال لأبيه وقومه ماذا تعبدون", "page": 449, "juz": 23}, "86": {"uthmani": "أَئِفْكًا ءَالِهَةًۭ دُونَ ٱللَّهِ تُرِيدُونَ", "simple": "أئفكا آلهة دون الله تريدون", "page": 449, "juz": 23}, "87": {"uthmani": "فَمَا ظَنُّكُم بِرَبِّ ٱلْعَٰلَمِينَ", "simple": "فما ظنكم برب العالمين", "page": 449, "juz": 23}, "88": {"uthmani": "فَنَظَرَ نَظْرَةًۭ فِى ٱلنُّجُومِ", "simple": "فنظر نظرة في النجوم", "page": 449, "juz": 23}, "89": {"uthmani": "فَقَالَ إِنِّى سَقِيمٌۭ", "simple": "فقال إني سقيم", "page": 449, "juz": 23}, "90": {"uthmani": "فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ", "simple": "فتولوا عنه مدبرين", "page": 449, "juz": 23}, "91": {"uthmani": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ", "simple": "فراغ إلى آلهتهم فقال ألا تأكلون", "page": 449, "juz": 23}, "92": {"uthmani": "مَا لَكُمْ لَا تَنطِقُونَ", "simple": "ما لكم لا تنطقون", "page": 449, "juz": 23}, "93": {"uthmani": "فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ", "simple": "فراغ عليهم ضربا باليمين", "page": 449, "juz": 23}, "94": {"uthmani": "فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ", "simple": "فأقبلوا إليه يزفون", "page": 449, "juz": 23}, "95": {"uthmani": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ", "simple": "قال أتعبدون ما تنحتون", "page": 449, "juz": 23}, "96": {"uthmani": "وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ", "simple": "والله خلقكم وما تعملون", "page": 449, "juz": 23}, "97": {"uthmani": "قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَٰنًۭا فَأَلْقُوهُ فِى ٱلْجَحِيمِ", "simple": "قالوا ابنوا له بنيانا فألقوه في الجحيم", "page": 449, "juz": 23}, "98": {"uthmani": "فَأَرَادُوا۟ بِهِۦ كَيْدًۭا فَجَعَلْنَٰهُمُ ٱلْأَسْفَلِينَ", "simple": "فأرادوا به كيدا فجعلناهم الأسفلين", "page": 449, "juz": 23}, "99": {"uthmani": "وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ", "simple": "وقال إني ذاهب إلى ربي سيهدين", "page": 449, "juz": 23}, "100": {"uthmani": "رَبِّ هَبْ لِى مِنَ ٱلصَّٰلِحِينَ", "simple": "رب هب لي من الصالحين", "page": 449, "juz": 23}, "101": {"uthmani": "فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٍۢ", "simple": "فبشرناه بغلام حليم", "page": 449, "juz": 23}, "102": {"uthmani": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ", "simple": "فلما بلغ معه السعي قال يا بني إني أرى في المنام أني أذبحك فانظر ماذا ترى ۚ قال يا أبت افعل ما تؤمر ۖ ستجدني إن شاء الله من الصابرين", "page": 449, "juz": 23}, "103": {"uthmani": "فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ", "simple": "فلما أسلما وتله للجبين", "page": 450, "juz": 23}, "104": {"uthmani": "وَنَٰدَيْنَٰهُ أَن يَٰٓإِبْرَٰهِيمُ", "simple": "وناديناه أن يا إبراهيم", "page": 450, "juz": 23}, "105": {"uthmani": "قَدْ صَدَّقْتَ ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "simple": "قد صدقت الرؤيا ۚ إنا كذلك نجزي المحسنين", "page": 450, "juz": 23}, "106": {"uthmani": "إِنَّ هَٰذَا لَهُوَ ٱلْبَلَٰٓؤُا۟ ٱلْمُبِينُ", "simple": "إن هذا لهو البلاء المبين", "page": 450, "juz": 23}, "107": {"uthmani": "وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٍۢ", "simple": "وفديناه بذبح عظيم", "page": 450, "juz": 23}, "108": {"uthmani": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ", "simple": "وتركنا عليه في الآخرين", "page": 450, "juz": 23}, "109": {"uthmani": "سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ", "simple": "سلام على إبراهيم", "page": 450, "juz": 23}, "110": {"uthmani": "كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "simple": "كذلك نجزي المحسنين", "page": 450, "juz": 23}, "111": {"uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ", "simple": "إنه من عبادنا المؤمنين", "page": 450, "juz": 23}, "112": {"uthmani": "وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيًّۭا مِّنَ ٱلصَّٰلِحِينَ", "simple": "وبشرناه بإسحاق نبيا من الصالحين", "page": 450, "juz": 23}, "113": {"uthmani": "وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌۭ وَظَالِمٌۭ لِّنَفْسِهِۦ مُبِينٌۭ", "simple": "وباركنا عليه وعلى إسحاق ۚ ومن ذريتهما محسن وظالم لنفسه مبين", "page": 450, "juz": 23}, "114": {"uthmani": "وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ", "simple": "ولقد مننا على موسى وهارون", "page": 450, "juz": 23}, "115": {"uthmani": "وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ", "simple": "ونجيناهما وقومهما من الكرب العظيم", "page": 450, "juz": 23}, "116": {"uthmani": "وَنَصَرْنَٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَٰلِبِينَ", "simple": "ونصرناهم فكانوا هم الغالبين", "page": 450, "juz": 23}, "117": {"uthmani": "وَءَاتَيْنَٰهُمَا ٱلْكِتَٰبَ ٱلْمُسْتَبِينَ", "simple": "وآتيناهما الكتاب المستبين", "page": 450, "juz": 23}, "118": {"uthmani": "وَهَدَيْنَٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ", "simple": "وهديناهما الصراط المستقيم", "page": 450, "juz": 23}, "119": {"uthmani": "وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْءَاخِرِينَ", "simple": "وتركنا عليهما في الآخرين", "page": 450, "juz": 23}, "120": {"uthmani": "سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ", "simple": "سلام على موسى وهارون", "page": 450, "juz": 23}, "121": {"uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "simple": "إنا كذلك نجزي المحسنين", "page": 450, "juz": 23}, "122": {"uthmani": "إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ", "simple": "إنهما من عبادنا المؤمنين", "page": 450, "juz": 23}, "123": {"uthmani": "وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ", "simple": "وإن إلياس لمن المرسلين", "page": 450, "juz": 23}, "124": {"uthmani": "إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ", "simple": "إذ قال لقومه ألا تتقون", "page": 450, "juz": 23}, "125": {"uthmani": "أَتَدْعُونَ بَعْلًۭا وَتَذَرُونَ أَحْسَنَ ٱلْخَٰلِقِينَ", "simple": "أتدعون بعلا وتذرون أحسن الخالقين", "page": 450, "juz": 23}, "126": {"uthmani": "ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ", "simple": "الله ربكم ورب آبائكم الأولين", "page": 450, "juz": 23}, "127": {"uthmani": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ", "simple": "فكذبوه فإنهم لمحضرون", "page": 451, "juz": 23}, "128": {"uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ", "simple": "إلا عباد الله المخلصين", "page": 451, "juz": 23}, "129": {"uthmani": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ", "simple": "وتركنا عليه في الآخرين", "page": 451, "juz": 23}, "130": {"uthmani": "سَلَٰمٌ عَلَىٰٓ إِلْ يَاسِينَ", "simple": "سلام على إل ياسين", "page": 451, "juz": 23}, "131": {"uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "simple": "إنا كذلك نجزي المحسنين", "page": 451, "juz": 23}, "132": {"uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ", "simple": "إنه من عبادنا المؤمنين", "page": 451, "juz": 23}, "133": {"uthmani": "وَإِنَّ لُوطًۭا لَّمِنَ ٱلْمُرْسَلِينَ", "simple": "وإن لوطا لمن المرسلين", "page": 451, "juz": 23}, "134": {"uthmani": "إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ", "simple": "إذ نجيناه وأهله أجمعين", "page": 451, "juz": 23}, "135": {"uthmani": "إِلَّا عَجُوزًۭا فِى ٱلْغَٰبِرِينَ", "simple": "إلا عجوزا في الغابرين", "page": 451, "juz": 23}, "136": {"uthmani": "ثُمَّ دَمَّرْنَا ٱلْءَاخَرِينَ", "simple": "ثم دمرنا الآخرين", "page": 451, "juz": 23}, "137": {"uthmani": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ", "simple": "وإنكم لتمرون عليهم مصبحين", "page": 451, "juz": 23}, "138": {"uthmani": "وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ", "simple": "وبالليل ۗ أفلا تعقلون", "page": 451, "juz": 23}, "139": {"uthmani": "وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ", "simple": "وإن يونس لمن المرسلين", "page": 451, "juz": 23}, "140": {"uthmani": "إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ", "simple": "إذ أبق إلى الفلك المشحون", "page": 451, "juz": 23}, "141": {"uthmani": "فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ", "simple": "فساهم فكان من المدحضين", "page": 451, "juz": 23}, "142": {"uthmani": "فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌۭ", "simple": "فالتقمه الحوت وهو مليم", "page": 451, "juz": 23}, "143": {"uthmani": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ", "simple": "فلولا أنه كان من المسبحين", "page": 451, "juz": 23}, "144": {"uthmani": "لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ", "simple": "للبث في بطنه إلى يوم يبعثون", "page": 451, "juz": 23}, "145": {"uthmani": "۞ فَنَبَذْنَٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌۭ", "simple": "۞ فنبذناه بالعراء وهو سقيم", "page": 451, "juz": 23}, "146": {"uthmani": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةًۭ مِّن يَقْطِينٍۢ", "simple": "وأنبتنا عليه شجرة من يقطين", "page": 451, "juz": 23}, "147": {"uthmani": "وَأَرْسَلْنَٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ", "simple": "وأرسلناه إلى مائة ألف أو يزيدون", "page": 451, "juz": 23}, "148": {"uthmani": "فَـَٔامَنُوا۟ فَمَتَّعْنَٰهُمْ إِلَىٰ حِينٍۢ", "simple": "فآمنوا فمتعناهم إلى حين", "page": 451, "juz": 23}, "149": {"uthmani": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ", "simple": "فاستفتهم ألربك البنات ولهم البنون", "page": 451, "juz": 23}, "150": {"uthmani": "أَمْ خَلَقْنَا ٱلْمَلَٰٓئِكَةَ إِنَٰثًۭا وَهُمْ شَٰهِدُونَ", "simple": "أم خلقنا الملائكة إناثا وهم شاهدون", "page": 451, "juz": 23}, "151": {"uthmani": "أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ", "simple": "ألا إنهم من إفكهم ليقولون", "page": 451, "juz": 23}, "152": {"uthmani": "وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَٰذِبُونَ", "simple": "ولد الله وإنهم لكاذبون", "page": 451, "juz": 23}, "153": {"uthmani": "أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ", "simple": "أصطفى البنات على البنين", "page": 451, "juz": 23}, "154": {"uthmani": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ", "simple": "ما لكم كيف تحكمون", "page": 452, "juz": 23}, "155": {"uthmani": "أَفَلَا تَذَكَّرُونَ", "simple": "أفلا تذكرون", "page": 452, "juz": 23}, "156": {"uthmani": "أَمْ لَكُمْ سُلْطَٰنٌۭ مُّبِينٌۭ", "simple": "أم لكم سلطان مبين", "page": 452, "juz": 23}, "157": {"uthmani": "فَأْتُوا۟ بِكِتَٰبِكُمْ إِن كُنتُمْ صَٰدِقِينَ", "simple": "فأتوا بكتابكم إن كنتم صادقين", "page": 452, "juz": 23}, "158": {"uthmani": "وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًۭا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ", "simple": "وجعلوا بينه وبين الجنة نسبا ۚ ولقد علمت الجنة إنهم لمحضرون", "page": 452, "juz": 23}, "159": {"uthmani": "سُبْحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ", "simple": "سبحان الله عما يصفون", "page": 452, "juz": 23}, "160": {"uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ", "simple": "إلا عباد الله المخلصين", "page": 452, "juz": 23}, "161": {"uthmani": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ", "simple": "فإنكم وما تعبدون", "page": 452, "juz": 23}, "162": {"uthmani": "مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ", "simple": "ما أنتم عليه بفاتنين", "page": 452, "juz": 23}, "163": {"uthmani": "إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ", "simple": "إلا من هو صال الجحيم", "page": 452, "juz": 23}, "164": {"uthmani": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌۭ مَّعْلُومٌۭ", "simple": "وما منا إلا له مقام معلوم", "page": 452, "juz": 23}, "165": {"uthmani": "وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ", "simple": "وإنا لنحن الصافون", "page": 452, "juz": 23}, "166": {"uthmani": "وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ", "simple": "وإنا لنحن المسبحون", "page": 452, "juz": 23}, "167": {"uthmani": "وَإِن كَانُوا۟ لَيَقُولُونَ", "simple": "وإن كانوا ليقولون", "page": 452, "juz": 23}, "168": {"uthmani": "لَوْ أَنَّ عِندَنَا ذِكْرًۭا مِّنَ ٱلْأَوَّلِينَ", "simple": "لو أن عندنا ذكرا من الأولين", "page": 452, "juz": 23}, "169": {"uthmani": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ", "simple": "لكنا عباد الله المخلصين", "page": 452, "juz": 23}, "170": {"uthmani": "فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ", "simple": "فكفروا به ۖ فسوف يعلمون", "page": 452, "juz": 23}, "171": {"uthmani": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ", "simple": "ولقد سبقت كلمتنا لعبادنا المرسلين", "page": 452, "juz": 23}, "172": {"uthmani": "إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ", "simple": "إنهم لهم المنصورون", "page": 452, "juz": 23}, "173": {"uthmani": "وَإِنَّ جُندَنَا لَهُمُ ٱلْغَٰلِبُونَ", "simple": "وإن جندنا لهم الغالبون", "page": 452, "juz": 23}, "174": {"uthmani": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍۢ", "simple": "فتول عنهم حتى حين", "page": 452, "juz": 23}, "175": {"uthmani": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ", "simple": "وأبصرهم فسوف يبصرون", "page": 452, "juz": 23}, "176": {"uthmani": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ", "simple": "أفبعذابنا يستعجلون", "page": 452, "juz": 23}, "177": {"uthmani": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ", "simple": "فإذا نزل بساحتهم فساء صباح المنذرين", "page": 452, "juz": 23}, "178": {"uthmani": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍۢ", "simple": "وتول عنهم حتى حين", "page": 452, "juz": 23}, "179": {"uthmani": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ", "simple": "وأبصر فسوف يبصرون", "page": 452, "juz": 23}, "180": {"uthmani": "سُبْحَٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ", "simple": "سبحان ربك رب العزة عما يصفون", "page": 452, "juz": 23}, "181": {"uthmani": "وَسَلَٰمٌ عَلَى ٱلْمُرْسَلِينَ", "simple": "وسلام على المرسلين", "page": 452, "juz": 23}, "182": {"uthmani": "وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ", "simple": "والحمد لله رب العالمين", "page": 452, "juz": 23}}}