{"surah": 81, "ayahs": {"1": {"uthmani": "إِذَا ٱلشَّمْسُ كُوِّرَتْ", "simple": "إذا الشمس كورت", "page": 586, "juz": 30}, "2": {"uthmani": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "simple": "وإذا النجوم انكدرت", "page": 586, "juz": 30}, "3": {"uthmani": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ", "simple": "وإذا الجبال سيرت", "page": 586, "juz": 30}, "4": {"uthmani": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ", "simple": "وإذا العشار عطلت", "page": 586, "juz": 30}, "5": {"uthmani": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ", "simple": "وإذا الوحوش حشرت", "page": 586, "juz": 30}, "6": {"uthmani": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ", "simple": "وإذا البحار سجرت", "page": 586, "juz": 30}, "7": {"uthmani": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ", "simple": "وإذا النفوس زوجت", "page": 586, "juz": 30}, "8": {"uthmani": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ", "simple": "وإذا الموءودة سئلت", "page": 586, "juz": 30}, "9": {"uthmani": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "simple": "بأي ذنب قتلت", "page": 586, "juz": 30}, "10": {"uthmani": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "simple": "وإذا الصحف نشرت", "page": 586, "juz": 30}, "11": {"uthmani": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "simple": "وإذا السماء كشطت", "page": 586, "juz": 30}, "12": {"uthmani": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "simple": "وإذا الجحيم سعرت", "page": 586, "juz": 30}, "13": {"uthmani": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "simple": "وإذا الجنة أزلفت", "page": 586, "juz": 30}, "14": {"uthmani": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "simple": "علمت نفس ما أحضرت", "page": 586, "juz": 30}, "15": {"uthmani": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ", "simple": "فلا أقسم بالخنس", "page": 586, "juz": 30}, "16": {"uthmani": "ٱلْجَوَارِ ٱلْكُنَّسِ", "simple": "الجوار الكنس", "page": 586, "juz": 30}, "17": {"uthmani": "وَٱلَّيْلِ إِذَا عَسْعَسَ", "simple": "والليل إذا عسعس", "page": 586, "juz": 30}, "18": {"uthmani": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ", "simple": "والصبح إذا تنفس", "page": 586, "juz": 30}, "19": {"uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "simple": "إنه لقول رسول كريم", "page": 586, "juz": 30}, "20": {"uthmani": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ", "simple": "ذي قوة عند ذي العرش مكين", "page": 586, "juz": 30}, "21": {"uthmani": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ", "simple": "مطاع ثم أمين", "page": 586, "juz": 30}, "22": {"uthmani": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ", "simple": "وما صاحبكم بمجنون", "page": 586, "juz": 30}, "23": {"uthmani": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ", "simple": "ولقد رآه بالأفق المبين", "page": 586, "juz": 30}, "24": {"uthmani": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ", "simple": "وما هو على الغيب بضنين", "page": 586, "juz": 30}, "25": {"uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ", "simple": "وما هو بقول شيطان رجيم", "page": 586, "juz": 30}, "26": {"uthmani": "فَأَيْنَ تَذْهَبُونَ", "simple": "فأين تذهبون", "page": 586, "juz": 30}, "27": {"uthmani": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "simple": "إن هو إلا ذكر للعالمين", "page": 586, "juz": 30}, "28": {"uthmani": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ", "simple": "لمن شاء منكم أن يستقيم", "page": 586, "juz": 30}, "29": {"uthmani": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ", "simple": "وما تشاءون إلا أن يشاء الله رب العالمين", "page": 586, "juz": 30}}}