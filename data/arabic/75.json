{"surah": 75, "ayahs": {"1": {"uthmani": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ", "simple": "لا أقسم بيوم القيامة", "page": 577, "juz": 29}, "2": {"uthmani": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ", "simple": "ولا أقسم بالنفس اللوامة", "page": 577, "juz": 29}, "3": {"uthmani": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ", "simple": "أيحسب الإنسان ألن نجمع عظامه", "page": 577, "juz": 29}, "4": {"uthmani": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ", "simple": "بلى قادرين على أن نسوي بنانه", "page": 577, "juz": 29}, "5": {"uthmani": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ", "simple": "بل يريد الإنسان ليفجر أمامه", "page": 577, "juz": 29}, "6": {"uthmani": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ", "simple": "يسأل أيان يوم القيامة", "page": 577, "juz": 29}, "7": {"uthmani": "فَإِذَا بَرِقَ ٱلْبَصَرُ", "simple": "فإذا برق البصر", "page": 577, "juz": 29}, "8": {"uthmani": "وَخَسَفَ ٱلْقَمَرُ", "simple": "وخسف القمر", "page": 577, "juz": 29}, "9": {"uthmani": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ", "simple": "وجمع الشمس والقمر", "page": 577, "juz": 29}, "10": {"uthmani": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ", "simple": "يقول الإنسان يومئذ أين المفر", "page": 577, "juz": 29}, "11": {"uthmani": "كَلَّا لَا وَزَرَ", "simple": "كلا لا وزر", "page": 577, "juz": 29}, "12": {"uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ", "simple": "إلى ربك يومئذ المستقر", "page": 577, "juz": 29}, "13": {"uthmani": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ", "simple": "ينبأ الإنسان يومئذ بما قدم وأخر", "page": 577, "juz": 29}, "14": {"uthmani": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ", "simple": "بل الإنسان على نفسه بصيرة", "page": 577, "juz": 29}, "15": {"uthmani": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ", "simple": "ولو ألقى معاذيره", "page": 577, "juz": 29}, "16": {"uthmani": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ", "simple": "لا تحرك به لسانك لتعجل به", "page": 577, "juz": 29}, "17": {"uthmani": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ", "simple": "إن علينا جمعه وقرآنه", "page": 577, "juz": 29}, "18": {"uthmani": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ", "simple": "فإذا قرأناه فاتبع قرآنه", "page": 577, "juz": 29}, "19": {"uthmani": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ", "simple": "ثم إن علينا بيانه", "page": 577, "juz": 29}, "20": {"uthmani": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ", "simple": "كلا بل تحبون العاجلة", "page": 578, "juz": 29}, "21": {"uthmani": "وَتَذَرُونَ ٱلْءَاخِرَةَ", "simple": "وتذرون الآخرة", "page": 578, "juz": 29}, "22": {"uthmani": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ", "simple": "وجوه يومئذ ناضرة", "page": 578, "juz": 29}, "23": {"uthmani": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ", "simple": "إلى ربها ناظرة", "page": 578, "juz": 29}, "24": {"uthmani": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ", "simple": "ووجوه يومئذ باسرة", "page": 578, "juz": 29}, "25": {"uthmani": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ", "simple": "تظن أن يفعل بها فاقرة", "page": 578, "juz": 29}, "26": {"uthmani": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ", "simple": "كلا إذا بلغت التراقي", "page": 578, "juz": 29}, "27": {"uthmani": "وَقِيلَ مَنْ ۜ رَاقٍۢ", "simple": "وقيل من ۜ راق", "page": 578, "juz": 29}, "28": {"uthmani": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ", "simple": "وظن أنه الفراق", "page": 578, "juz": 29}, "29": {"uthmani": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ", "simple": "والتفت الساق بالساق", "page": 578, "juz": 29}, "30": {"uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ", "simple": "إلى ربك يومئذ المساق", "page": 578, "juz": 29}, "31": {"uthmani": "فَلَا صَدَّقَ وَلَا صَلَّىٰ", "simple": "فلا صدق ولا صلى", "page": 578, "juz": 29}, "32": {"uthmani": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ", "simple": "ولكن كذب وتولى", "page": 578, "juz": 29}, "33": {"uthmani": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ", "simple": "ثم ذهب إلى أهله يتمطى", "page": 578, "juz": 29}, "34": {"uthmani": "أَوْلَىٰ لَكَ فَأَوْلَىٰ", "simple": "أولى لك فأولى", "page": 578, "juz": 29}, "35": {"uthmani": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ", "simple": "ثم أولى لك فأولى", "page": 578, "juz": 29}, "36": {"uthmani": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى", "simple": "أيحسب الإنسان أن يترك سدى", "page": 578, "juz": 29}, "37": {"uthmani": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ", "simple": "ألم يك نطفة من مني يمنى", "page": 578, "juz": 29}, "38": {"uthmani": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ", "simple": "ثم كان علقة فخلق فسوى", "page": 578, "juz": 29}, "39": {"uthmani": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "simple": "فجعل منه الزوجين الذكر والأنثى", "page": 578, "juz": 29}, "40": {"uthmani": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ", "simple": "أليس ذلك بقادر على أن يحيي الموتى", "page": 578, "juz": 29}}}