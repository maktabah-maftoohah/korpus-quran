{"surah": 91, "ayahs": {"1": {"uthmani": "وَٱلشَّمْسِ وَضُحَىٰهَا", "simple": "والشمس وضحاها", "page": 595, "juz": 30}, "2": {"uthmani": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا", "simple": "والقمر إذا تلاها", "page": 595, "juz": 30}, "3": {"uthmani": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا", "simple": "والنهار إذا جلاها", "page": 595, "juz": 30}, "4": {"uthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا", "simple": "والليل إذا يغشاها", "page": 595, "juz": 30}, "5": {"uthmani": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا", "simple": "والسماء وما بناها", "page": 595, "juz": 30}, "6": {"uthmani": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا", "simple": "والأرض وما طحاها", "page": 595, "juz": 30}, "7": {"uthmani": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا", "simple": "ونفس وما سواها", "page": 595, "juz": 30}, "8": {"uthmani": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا", "simple": "فألهمها فجورها وتقواها", "page": 595, "juz": 30}, "9": {"uthmani": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا", "simple": "قد أفلح من زكاها", "page": 595, "juz": 30}, "10": {"uthmani": "وَقَدْ خَابَ مَن دَسَّىٰهَا", "simple": "وقد خاب من دساها", "page": 595, "juz": 30}, "11": {"uthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ", "simple": "كذبت ثمود بطغواها", "page": 595, "juz": 30}, "12": {"uthmani": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا", "simple": "إذ انبعث أشقاها", "page": 595, "juz": 30}, "13": {"uthmani": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا", "simple": "فقال لهم رسول الله ناقة الله وسقياها", "page": 595, "juz": 30}, "14": {"uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا", "simple": "فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسواها", "page": 595, "juz": 30}, "15": {"uthmani": "وَلَا يَخَافُ عُقْبَٰهَا", "simple": "ولا يخاف عقباها", "page": 595, "juz": 30}}}