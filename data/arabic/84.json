{"surah": 84, "ayahs": {"1": {"uthmani": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ", "simple": "إذا السماء انشقت", "page": 589, "juz": 30}, "2": {"uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "simple": "وأذنت لربها وحقت", "page": 589, "juz": 30}, "3": {"uthmani": "وَإِذَا ٱلْأَرْضُ مُدَّتْ", "simple": "وإذا الأرض مدت", "page": 589, "juz": 30}, "4": {"uthmani": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ", "simple": "وألقت ما فيها وتخلت", "page": 589, "juz": 30}, "5": {"uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "simple": "وأذنت لربها وحقت", "page": 589, "juz": 30}, "6": {"uthmani": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ", "simple": "يا أيها الإنسان إنك كادح إلى ربك كدحا فملاقيه", "page": 589, "juz": 30}, "7": {"uthmani": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ", "simple": "فأما من أوتي كتابه بيمينه", "page": 589, "juz": 30}, "8": {"uthmani": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا", "simple": "فسوف يحاسب حسابا يسيرا", "page": 589, "juz": 30}, "9": {"uthmani": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا", "simple": "وينقلب إلى أهله مسرورا", "page": 589, "juz": 30}, "10": {"uthmani": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ", "simple": "وأما من أوتي كتابه وراء ظهره", "page": 589, "juz": 30}, "11": {"uthmani": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا", "simple": "فسوف يدعو ثبورا", "page": 589, "juz": 30}, "12": {"uthmani": "وَيَصْلَىٰ سَعِيرًا", "simple": "ويصلى سعيرا", "page": 589, "juz": 30}, "13": {"uthmani": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا", "simple": "إنه كان في أهله مسرورا", "page": 589, "juz": 30}, "14": {"uthmani": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ", "simple": "إنه ظن أن لن يحور", "page": 589, "juz": 30}, "15": {"uthmani": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا", "simple": "بلى إن ربه كان به بصيرا", "page": 589, "juz": 30}, "16": {"uthmani": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ", "simple": "فلا أقسم بالشفق", "page": 589, "juz": 30}, "17": {"uthmani": "وَٱلَّيْلِ وَمَا وَسَقَ", "simple": "والليل وما وسق", "page": 589, "juz": 30}, "18": {"uthmani": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ", "simple": "والقمر إذا اتسق", "page": 589, "juz": 30}, "19": {"uthmani": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ", "simple": "لتركبن طبقا عن طبق", "page": 589, "juz": 30}, "20": {"uthmani": "فَمَا لَهُمْ لَا يُؤْمِنُونَ", "simple": "فما لهم لا يؤمنون", "page": 589, "juz": 30}, "21": {"uthmani": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩", "simple": "وإذا قرئ عليهم القرآن لا يسجدون ۩", "page": 589, "juz": 30}, "22": {"uthmani": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ", "simple": "بل الذين كفروا يكذبون", "page": 589, "juz": 30}, "23": {"uthmani": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ", "simple": "والله أعلم بما يوعون", "page": 589, "juz": 30}, "24": {"uthmani": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ", "simple": "فبشرهم بعذاب أليم", "page": 589, "juz": 30}, "25": {"uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ", "simple": "إلا الذين آمنوا وعملوا الصالحات لهم أجر غير ممنون", "page": 589, "juz": 30}}}