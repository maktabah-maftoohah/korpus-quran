{"surah": 1, "ayahs": {"1": {"uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ", "simple": "بسم الله الرحمن الرحيم", "page": 1, "juz": 1}, "2": {"uthmani": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ", "simple": "الحمد لله رب العالمين", "page": 1, "juz": 1}, "3": {"uthmani": "ٱلرَّحْمَٰنِ ٱلرَّحِيمِ", "simple": "الرحمن الرحيم", "page": 1, "juz": 1}, "4": {"uthmani": "مَٰلِكِ يَوْمِ ٱلدِّينِ", "simple": "مالك يوم الدين", "page": 1, "juz": 1}, "5": {"uthmani": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ", "simple": "إياك نعبد وإياك نستعين", "page": 1, "juz": 1}, "6": {"uthmani": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ", "simple": "اهدنا الصراط المستقيم", "page": 1, "juz": 1}, "7": {"uthmani": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ", "simple": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين", "page": 1, "juz": 1}}}