{"surah": 77, "ayahs": {"1": {"uthmani": "وَٱلْمُرْسَلَٰتِ عُرْفًۭا", "simple": "والمرسلات عرفا", "page": 580, "juz": 29}, "2": {"uthmani": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا", "simple": "فالعاصفات عصفا", "page": 580, "juz": 29}, "3": {"uthmani": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا", "simple": "والناشرات نشرا", "page": 580, "juz": 29}, "4": {"uthmani": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا", "simple": "فالفارقات فرقا", "page": 580, "juz": 29}, "5": {"uthmani": "فَٱلْمُلْقِيَٰتِ ذِكْرًا", "simple": "فالملقيات ذكرا", "page": 580, "juz": 29}, "6": {"uthmani": "عُذْرًا أَوْ نُذْرًا", "simple": "عذرا أو نذرا", "page": 580, "juz": 29}, "7": {"uthmani": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ", "simple": "إنما توعدون لواقع", "page": 580, "juz": 29}, "8": {"uthmani": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ", "simple": "فإذا النجوم طمست", "page": 580, "juz": 29}, "9": {"uthmani": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ", "simple": "وإذا السماء فرجت", "page": 580, "juz": 29}, "10": {"uthmani": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ", "simple": "وإذا الجبال نسفت", "page": 580, "juz": 29}, "11": {"uthmani": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ", "simple": "وإذا الرسل أقتت", "page": 580, "juz": 29}, "12": {"uthmani": "لِأَىِّ يَوْمٍ أُجِّلَتْ", "simple": "لأي يوم أجلت", "page": 580, "juz": 29}, "13": {"uthmani": "لِيَوْمِ ٱلْفَصْلِ", "simple": "ليوم الفصل", "page": 580, "juz": 29}, "14": {"uthmani": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ", "simple": "وما أدراك ما يوم الفصل", "page": 580, "juz": 29}, "15": {"uthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "simple": "ويل يومئذ للمكذبين", "page": 580, "juz": 29}, "16": {"uthmani": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ", "simple": "ألم نهلك الأولين", "page": 580, "juz": 29}, "17": {"uthmani": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ", "simple": "ثم نتبعهم الآخرين", "page": 580, "juz": 29}, "18": {"uthmani": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ", "simple": "كذلك نفعل بالمجرمين", "page": 580, "juz": 29}, "19": {"uthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "simple": "ويل يومئذ للمكذبين", "page": 580, "juz": 29}, "20": {"uthmani": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ", "simple": "ألم نخلقكم من ماء مهين", "page": 581, "juz": 29}, "21": {"uthmani": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ", "simple": "فجعلناه في قرار مكين", "page": 581, "juz": 29}, "22": {"uthmani": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ", "simple": "إلى قدر معلوم", "page": 581, "juz": 29}, "23": {"uthmani": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ", "simple": "فقدرنا فنعم القادرون", "page": 581, "juz": 29}, "24": {"uthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "simple": "ويل يومئذ للمكذبين", "page": 581, "juz": 29}, "25": {"uthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا", "simple": "ألم نجعل الأرض كفاتا", "page": 581, "juz": 29}, "26": {"uthmani": "أَحْيَآءًۭ وَأَمْوَٰتًۭا", "simple": "أحياء وأمواتا", "page": 581, "juz": 29}, "27": {"uthmani": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا", "simple": "وجعلنا فيها رواسي شامخات وأسقيناكم ماء فراتا", "page": 581, "juz": 29}, "28": {"uthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "simple": "ويل يومئذ للمكذبين", "page": 581, "juz": 29}, "29": {"uthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ", "simple": "انطلقوا إلى ما كنتم به تكذبون", "page": 581, "juz": 29}, "30": {"uthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ", "simple": "انطلقوا إلى ظل ذي ثلاث شعب", "page": 581, "juz": 29}, "31": {"uthmani": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ", "simple": "لا ظليل ولا يغني من اللهب", "page": 581, "juz": 29}, "32": {"uthmani": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ", "simple": "إنها ترمي بشرر كالقصر", "page": 581, "juz": 29}, "33": {"uthmani": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ", "simple": "كأنه جمالت صفر", "page": 581, "juz": 29}, "34": {"uthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "simple": "ويل يومئذ للمكذبين", "page": 581, "juz": 29}, "35": {"uthmani": "هَٰذَا يَوْمُ لَا يَنطِقُونَ", "simple": "هذا يوم لا ينطقون", "page": 581, "juz": 29}, "36": {"uthmani": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ", "simple": "ولا يؤذن لهم فيعتذرون", "page": 581, "juz": 29}, "37": {"uthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "simple": "ويل يومئذ للمكذبين", "page": 581, "juz": 29}, "38": {"uthmani": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ", "simple": "هذا يوم الفصل ۖ جمعناكم والأولين", "page": 581, "juz": 29}, "39": {"uthmani": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ", "simple": "فإن كان لكم كيد فكيدون", "page": 581, "juz": 29}, "40": {"uthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "simple": "ويل يومئذ للمكذبين", "page": 581, "juz": 29}, "41": {"uthmani": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ", "simple": "إن المتقين في ظلال وعيون", "page": 581, "juz": 29}, "42": {"uthmani": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ", "simple": "وفواكه مما يشتهون", "page": 581, "juz": 29}, "43": {"uthmani": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ", "simple": "كلوا واشربوا هنيئا بما كنتم تعملون", "page": 581, "juz": 29}, "44": {"uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "simple": "إنا كذلك نجزي المحسنين", "page": 581, "juz": 29}, "45": {"uthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "simple": "ويل يومئذ للمكذبين", "page": 581, "juz": 29}, "46": {"uthmani": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ", "simple": "كلوا وتمتعوا قليلا إنكم مجرمون", "page": 581, "juz": 29}, "47": {"uthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "simple": "ويل يومئذ للمكذبين", "page": 581, "juz": 29}, "48": {"uthmani": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ", "simple": "وإذا قيل لهم اركعوا لا يركعون", "page": 581, "juz": 29}, "49": {"uthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "simple": "ويل يومئذ للمكذبين", "page": 581, "juz": 29}, "50": {"uthmani": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ", "simple": "فبأي حديث بعده يؤمنون", "page": 581, "juz": 29}}}