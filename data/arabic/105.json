{"surah": 105, "ayahs": {"1": {"uthmani": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ", "simple": "ألم تر كيف فعل ربك بأصحاب الفيل", "page": 601, "juz": 30}, "2": {"uthmani": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ", "simple": "ألم يجعل كيدهم في تضليل", "page": 601, "juz": 30}, "3": {"uthmani": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ", "simple": "وأرسل عليهم طيرا أبابيل", "page": 601, "juz": 30}, "4": {"uthmani": "تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ", "simple": "ترميهم بحجارة من سجيل", "page": 601, "juz": 30}, "5": {"uthmani": "فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ", "simple": "فجعلهم كعصف مأكول", "page": 601, "juz": 30}}}