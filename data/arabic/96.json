{"surah": 96, "ayahs": {"1": {"uthmani": "ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ", "simple": "اقرأ باسم ربك الذي خلق", "page": 597, "juz": 30}, "2": {"uthmani": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ", "simple": "خلق الإنسان من علق", "page": 597, "juz": 30}, "3": {"uthmani": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ", "simple": "اقرأ وربك الأكرم", "page": 597, "juz": 30}, "4": {"uthmani": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ", "simple": "الذي علم بالقلم", "page": 597, "juz": 30}, "5": {"uthmani": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ", "simple": "علم الإنسان ما لم يعلم", "page": 597, "juz": 30}, "6": {"uthmani": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ", "simple": "كلا إن الإنسان ليطغى", "page": 597, "juz": 30}, "7": {"uthmani": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ", "simple": "أن رآه استغنى", "page": 597, "juz": 30}, "8": {"uthmani": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ", "simple": "إن إلى ربك الرجعى", "page": 597, "juz": 30}, "9": {"uthmani": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ", "simple": "أرأيت الذي ينهى", "page": 597, "juz": 30}, "10": {"uthmani": "عَبْدًا إِذَا صَلَّىٰٓ", "simple": "عبدا إذا صلى", "page": 597, "juz": 30}, "11": {"uthmani": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ", "simple": "أرأيت إن كان على الهدى", "page": 597, "juz": 30}, "12": {"uthmani": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ", "simple": "أو أمر بالتقوى", "page": 597, "juz": 30}, "13": {"uthmani": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ", "simple": "أرأيت إن كذب وتولى", "page": 597, "juz": 30}, "14": {"uthmani": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ", "simple": "ألم يعلم بأن الله يرى", "page": 597, "juz": 30}, "15": {"uthmani": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ", "simple": "كلا لئن لم ينته لنسفعا بالناصية", "page": 597, "juz": 30}, "16": {"uthmani": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ", "simple": "ناصية كاذبة خاطئة", "page": 597, "juz": 30}, "17": {"uthmani": "فَلْيَدْعُ نَادِيَهُۥ", "simple": "فليدع ناديه", "page": 597, "juz": 30}, "18": {"uthmani": "سَنَدْعُ ٱلزَّبَانِيَةَ", "simple": "سندع الزبانية", "page": 597, "juz": 30}, "19": {"uthmani": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩", "simple": "كلا لا تطعه واسجد واقترب ۩", "page": 597, "juz": 30}}}