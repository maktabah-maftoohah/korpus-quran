{"surah": 87, "ayahs": {"1": {"uthmani": "سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى", "simple": "سبح اسم ربك الأعلى", "page": 591, "juz": 30}, "2": {"uthmani": "ٱلَّذِى خَلَقَ فَسَوَّىٰ", "simple": "الذي خلق فسوى", "page": 591, "juz": 30}, "3": {"uthmani": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ", "simple": "والذي قدر فهدى", "page": 591, "juz": 30}, "4": {"uthmani": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ", "simple": "والذي أخرج المرعى", "page": 591, "juz": 30}, "5": {"uthmani": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ", "simple": "فجعله غثاء أحوى", "page": 591, "juz": 30}, "6": {"uthmani": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ", "simple": "سنقرئك فلا تنسى", "page": 591, "juz": 30}, "7": {"uthmani": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ", "simple": "إلا ما شاء الله ۚ إنه يعلم الجهر وما يخفى", "page": 591, "juz": 30}, "8": {"uthmani": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ", "simple": "ونيسرك لليسرى", "page": 591, "juz": 30}, "9": {"uthmani": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ", "simple": "فذكر إن نفعت الذكرى", "page": 591, "juz": 30}, "10": {"uthmani": "سَيَذَّكَّرُ مَن يَخْشَىٰ", "simple": "سيذكر من يخشى", "page": 591, "juz": 30}, "11": {"uthmani": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى", "simple": "ويتجنبها الأشقى", "page": 591, "juz": 30}, "12": {"uthmani": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ", "simple": "الذي يصلى النار الكبرى", "page": 591, "juz": 30}, "13": {"uthmani": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ", "simple": "ثم لا يموت فيها ولا يحيى", "page": 591, "juz": 30}, "14": {"uthmani": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ", "simple": "قد أفلح من تزكى", "page": 591, "juz": 30}, "15": {"uthmani": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ", "simple": "وذكر اسم ربه فصلى", "page": 591, "juz": 30}, "16": {"uthmani": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "simple": "بل تؤثرون الحياة الدنيا", "page": 592, "juz": 30}, "17": {"uthmani": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ", "simple": "والآخرة خير وأبقى", "page": 592, "juz": 30}, "18": {"uthmani": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ", "simple": "إن هذا لفي الصحف الأولى", "page": 592, "juz": 30}, "19": {"uthmani": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ", "simple": "صحف إبراهيم وموسى", "page": 592, "juz": 30}}}